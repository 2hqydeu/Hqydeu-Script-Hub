-- CreateFeatureRow's Label/Toggle (and their UICorners) never get a ZIndex of their own,
-- so bumping only the row itself would leave them sitting under this ZIndex-41 popup --
-- invisible. Bump every descendant, not just the row.
local function BumpZIndex(instance, zIndex)
	instance.ZIndex = zIndex
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("GuiObject") then descendant.ZIndex = zIndex end
	end
end

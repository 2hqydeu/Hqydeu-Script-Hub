-- Classification can change after an instance is already tracked (patients gain IsPatient
-- once checked in, a threat's reveal signals can appear later), so this re-checks
-- everything tracked on a light throttle instead of wiring per-attribute signals for each
-- one -- simpler, and cheap at the handful of NPCs/props this game has active at once.
local lastClassifyPass = 0
-- How long a freshly-tracked instance is exempt from the Anomalies heuristic -- see the
-- comment above ClassifyInstance for why (ambulance arrivals like Leo Takeda).
local ESP_DISGUISE_GRACE_PERIOD = 3
local function RefreshESPClassifications()
	local now = os.clock()
	if now - lastClassifyPass < 0.25 then return end
	lastClassifyPass = now
	for instance, entry in pairs(espTracked) do
		if instance.Parent then
			-- Self-heal the outline if something destroyed it out from under this instance
			-- without the instance itself going anywhere -- likely cause of the outline
			-- vanishing (while the label stayed put) specifically when patients lie down in
			-- a bed: the game has its own built-in "PatientHighlight" Highlight on some
			-- rigs, and bed logic that clears ITS OWN highlight by class rather than by name
			-- would take this one down too as an innocent bystander sitting right next to it.
			if not entry.Highlight or not entry.Highlight.Parent then
				local highlight = Instance.new("Highlight")
				highlight.Name = "SerenityESP"
				highlight.FillTransparency = 1
				highlight.OutlineTransparency = 0
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.Adornee = instance
				highlight.Parent = instance
				entry.Highlight = highlight
			end
			-- pcall'd so one bad instance erroring can't silently kill classification for
			-- everything else tracked -- exactly what the MeshPart/BasePart bug above did.
			local skipDisguiseCheck = (now - (entry.CreatedAt or 0)) < ESP_DISGUISE_GRACE_PERIOD
			local ok, classification, color, category = pcall(ClassifyInstance, instance, skipDisguiseCheck)
			if ok then
				if entry.Label.Text ~= classification then
					entry.Label.Text = classification
					entry.Label.TextColor3 = color
				end
				entry.Highlight.OutlineColor = color
				entry.Category = category
				local visible = espShow[category] ~= false
				entry.Highlight.Enabled = visible
				entry.Billboard.Enabled = visible
			end
		end
	end
end

-- Primary tracking is the actual workspace.NPCs folder every patient/visitor/NPC-style
-- anomaly gets parented into on spawn, watched for real-time add. Deliberately NOT watching
-- ChildRemoved on that folder -- a patient moving into a bed (or any other in-folder
-- reparent) fires ChildRemoved without the NPC actually being gone, which was exactly why
-- ESP outlines kept vanishing on patients lying down. Real cleanup happens once, uniformly,
-- via each tracked instance's own AncestryChanged connection in CreateESPFor (parent
-- becoming nil = actually destroyed), regardless of which folder momentarily held it. The
-- CollectionService "NPC"/"Unique" tags are watched too, as a fallback for anything tagged
-- but not actually parented under that folder. Event anomalies are room props that never
-- touch workspace.NPCs or that tag at all, so they get their own workspace-wide watch.
local watchConnections = {}
local function StartESP()
	local npcFolder = workspace:FindFirstChild("NPCs")
	if npcFolder then
		for _, child in ipairs(npcFolder:GetChildren()) do
			CreateESPFor(child)
		end
		table.insert(watchConnections, npcFolder.ChildAdded:Connect(CreateESPFor))
	end
	for _, tagName in ipairs({"NPC", "Unique"}) do
		for _, model in ipairs(CollectionService:GetTagged(tagName)) do
			CreateESPFor(model)
		end
		table.insert(watchConnections, CollectionService:GetInstanceAddedSignal(tagName):Connect(CreateESPFor))
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if EVENT_ANOMALY_NAMES[descendant.Name] then CreateESPFor(descendant) end
	end
	table.insert(watchConnections, workspace.DescendantAdded:Connect(function(descendant)
		if EVENT_ANOMALY_NAMES[descendant.Name] then CreateESPFor(descendant) end
	end))
end

local function StopESP()
	for _, connection in ipairs(watchConnections) do connection:Disconnect() end
	watchConnections = {}
	espPending = {}
	for instance in pairs(espTracked) do RemoveESPFrom(instance) end
end


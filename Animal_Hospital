-- ESP -----------------------------------------------------------------------------------
-- Patients and Visitors both carry a plain attribute; "Unique" covers the wildcard lobby
-- extras (Barney, the Clown, Officer Duckman, etc. -- confirmed as the UniqueVisitors
-- folder) that sometimes just chit-chat and sometimes turn out to be part of a jumpscare.
--
-- Anomalies split into two groups per testing: "Anomalies" are the ones that behave like
-- actual attacking NPCs (Ghost, Stalker, Tall Monster, Slimebert -- tracked the same way as
-- patients, through workspace.NPCs) vs. "Events", room-placed hazards/props (EyeMass,
-- Candles, Shadow, Hider, Bed Monster/Large) that never touch workspace.NPCs or carry the
-- "NPC" tag at all -- that's why EyeMass/MonsterBed never showed up before; they needed
-- their own workspace-wide watch, added below.
--
-- Disguised Threat (the patient-that-turns-out-to-attack-you case) traces back to
-- ReplicatedStorage.AnomalyEvents.DisguiseReveals. Four independent signals, OR'd together:
-- SkinwalkerOpensMouth.Apply() sets Transparency = 0 on {Gulp, Tooth, TongueMesh, Spit,
-- Teeth} (normally 1/hidden) -- confirmed by the visible Tooth/TongueMesh you spotted on
-- "Lucy Acorns". The reveal itself is also gated by a "CameraEffect"/"PhotoEffect"
-- Attribute read directly off the model -- since Attributes replicate the moment they're
-- set server-side, reading it directly should catch the threat even before ever pointing a
-- camera at them. And the two face TextureIDs found directly on a confirmed threat in
-- testing are checked against the specific face part.
--
-- Reverted back to this narrower version after the broadened one (checking a "SecondEars"
-- child's mere presence, plus every mesh/texture ID against every part on the model) turned
-- out to flag literally everyone as a Disguised Threat -- "SecondEars" apparently isn't
-- exclusive to the real one the way DifferentEars.Apply's own logic implied. This is the
-- version confirmed working correctly in testing before that regression.
local ESP_PATIENT_COLOR = Color3.fromRGB(255, 255, 255)
local ESP_VISITOR_COLOR = Color3.fromRGB(80, 220, 100)
local ESP_ANOMALY_COLOR = Color3.fromRGB(255, 60, 60)
local ESP_EVENT_COLOR = Color3.fromRGB(190, 90, 255)
local ESP_UNIQUE_COLOR = Color3.fromRGB(255, 150, 40)
local ESP_UNKNOWN_COLOR = Color3.fromRGB(255, 210, 60)

local SKINWALKER_PARTS = {"Gulp", "Tooth", "TongueMesh", "Spit", "Teeth"}
local DISGUISE_ATTRIBUTES = {"CameraEffect", "CameraEffect2", "PhotoEffect", "PhotoEffect2"}
local KNOWN_DISGUISE_FACE_IDS = {
	["rbxassetid://117344367007423"] = true,
	["rbxassetid://134031923875296"] = true,
}

local function HasDisguiseAttribute(model)
	for _, attributeName in ipairs(DISGUISE_ATTRIBUTES) do
		if model:GetAttribute(attributeName) then return true end
	end
	return false
end

local function HasVisibleSkinwalkerParts(model)
	for _, partName in ipairs(SKINWALKER_PARTS) do
		local part = model:FindFirstChild(partName)
		if part and part:IsA("BasePart") and part.Transparency < 0.95 then
			return true
		end
	end
	return false
end

-- DifferentFace.Apply swaps a face MeshPart's TextureID and stashes the new value under a
-- "SecondFace" attribute -- OriginalFace (present on every patient) is what it restores on
-- UnDo, so a face that no longer matches its own OriginalFace has been swapped by *some*
-- reveal effect, not just this specific one.
local function HasSwappedOrKnownBadFace(model)
	local facePart = model:FindFirstChild("Head.002") or model:FindFirstChild("Face")
	if not facePart or not facePart:IsA("MeshPart") then return false end
	local textureId = facePart.TextureID
	if not textureId or textureId == "" then return false end
	if KNOWN_DISGUISE_FACE_IDS[textureId] then return true end
	local originalFace = model:GetAttribute("OriginalFace")
	return originalFace ~= nil and originalFace ~= "" and textureId ~= originalFace
end

-- Unconfirmed lead (flagged as such, not verified) -- an exaggerated stutter/jitter
-- animation you spotted on an Unknown NPC you believed was the real threat. Checked as an
-- extra OR'd signal since it costs nothing if it turns out to be wrong (never matches,
-- changes nothing) but could catch exactly the jittering-Unknown case that's currently the
-- only one slipping through.
local JITTER_ANIMATION_ID = "rbxassetid://113812248601150"
local function IsPlayingJitterAnimation(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return false end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		if track.Animation and track.Animation.AnimationId == JITTER_ANIMATION_ID then
			return true
		end
	end
	return false
end

local function IsDisguisedThreat(model)
	return HasDisguiseAttribute(model)
		or HasVisibleSkinwalkerParts(model)
		or HasSwappedOrKnownBadFace(model)
		or IsPlayingJitterAnimation(model)
end

-- Anomaly templates that behave like actual attacking NPCs -- tracked through
-- workspace.NPCs, same as patients.
local NPC_ANOMALY_NAMES = {
	TallMonster = true, TallMonster0 = true, TallMonster2 = true,
	TallMonsterFace = true, TallMonsterHead = true, Ghost = true, Skinwalker = true,
}
local ANOMALY_SIGNALS = {
	{label = "Ghost", tag = "GhostAnomaly"},
	{label = "Stalker", tag = "StalkerJumpscare"},
	{label = "Tall Monster", tag = "TallMonsterSpawn"},
	{label = "Slimebert", attribute = "IsSlimebert"},
}

-- Anomaly templates that are room-placed hazards/props instead -- never touch
-- workspace.NPCs, watched workspace-wide by name below. Slime (workspace.Misc.Slime)
-- included even though it lives outside workspace.Misc specifically rather than NPCs --
-- the workspace-wide name scan below doesn't care which folder it's actually in. Shadow
-- dropped entirely per your feedback -- just a pointless room part, not worth ESPing.
local EVENT_ANOMALY_NAMES = {
	EyeMass = true, Candles = true, Hider = true,
	MonsterBed = true, MonsterBedLarge = true, Slime = true,
}
local EVENT_ANOMALY_SIGNALS = {}

-- Named lobby extras from ReplicatedStorage.NPCs.UniqueVisitors -- checked by name as a
-- backup to the "Unique" tag in case that tag isn't reliably applied to all of them.
local UNIQUE_VISITOR_NAMES = {
	["Officer Duckman"] = true, ["Barney"] = true, ["Clown"] = true, ["DoctorOld"] = true,
	["Ratthew"] = true, ["Ron from Accounting"] = true, ["Liz"] = true, ["Doctor"] = true,
	["Hazmat"] = true, ["TinyGuy"] = true, ["Sam"] = true,
}

-- Returns label, color, and a category key (used by the ESP Options popup's per-category
-- toggles further down). Confirmed name/tag matches are checked BEFORE the Anomalies
-- heuristic now, not after -- Hider (an Event, identified purely by name) was flickering
-- between "Hider" and the heuristic because its own rig apparently trips one of the
-- disguise checks on its own sometimes. A confident name/tag match should always win over a
-- heuristic guess; the heuristic is really only meant to catch things that AREN'T already
-- identifiable another way (a patient secretly being the real threat).
--
-- skipDisguiseCheck is true for the first ESP_DISGUISE_GRACE_PERIOD seconds after an
-- instance is first tracked (see RefreshESPClassifications) -- ambulance-arrival patients
-- (confirmed by name: Leo Takeda and others) were showing up as false Anomalies even though
-- treating them proved they were completely normal patients. They skip the usual check-in
-- flow, so their parts/attributes most likely just need a moment longer to settle into
-- their normal hidden state than a regular walk-in patient's do -- this grace window keeps
-- brand new arrivals from being judged before that settling has had a chance to finish.
local function ClassifyInstance(instance, skipDisguiseCheck)
	if NPC_ANOMALY_NAMES[instance.Name] then
		return instance.Name, ESP_ANOMALY_COLOR, "anomaly"
	end
	for _, signal in ipairs(ANOMALY_SIGNALS) do
		if signal.tag and instance:HasTag(signal.tag) then
			return signal.label, ESP_ANOMALY_COLOR, "anomaly"
		end
		if signal.attribute and instance:GetAttribute(signal.attribute) then
			return signal.label, ESP_ANOMALY_COLOR, "anomaly"
		end
	end
	if EVENT_ANOMALY_NAMES[instance.Name] then
		return instance.Name, ESP_EVENT_COLOR, "event"
	end
	for _, signal in ipairs(EVENT_ANOMALY_SIGNALS) do
		if signal.tag and instance:HasTag(signal.tag) then
			return signal.label, ESP_EVENT_COLOR, "event"
		end
	end
	if not skipDisguiseCheck and instance:IsA("Model") and IsDisguisedThreat(instance) then
		-- Same "anomaly" category as everything else red -- combined per your request so
		-- there's one Anomalies toggle covering both instead of a separate Disguise one.
		return "Anomalies", ESP_ANOMALY_COLOR, "anomaly"
	end
	if instance:GetAttribute("IsPatient") == true then
		return "Patient", ESP_PATIENT_COLOR, "patient"
	end
	if instance:GetAttribute("IsVisitor") == true then
		return "Visitor", ESP_VISITOR_COLOR, "visitor"
	end
	-- Unique and Unknown share one toggle (both still shown with their own label/color) --
	-- combined per your request.
	if instance:HasTag("Unique") or UNIQUE_VISITOR_NAMES[instance.Name] then
		return "Unique", ESP_UNIQUE_COLOR, "unique"
	end
	return "Unknown", ESP_UNKNOWN_COLOR, "unique"
end

-- Per-category show/hide, wired up by the ESP Options popup further down -- declared this
-- early (before anything that reads it as an upvalue) since Lua locals only apply to code
-- after their own declaration in the same block.
local espShow = {patient = true, visitor = true, anomaly = true, event = true, unique = true}

local espEnabled = false
local espTracked = {} -- instance -> {Highlight, Billboard, Label, Category, AncestryConn}
local espPending = {} -- set of instances currently waiting to be measured/adorned

local function RemoveESPFrom(instance)
	espPending[instance] = nil
	local entry = espTracked[instance]
	if not entry then return end
	if entry.AncestryConn then entry.AncestryConn:Disconnect() end
	if entry.Highlight then entry.Highlight:Destroy() end
	if entry.Billboard then entry.Billboard:Destroy() end
	espTracked[instance] = nil
end

-- Bounding-box half-height instead of hunting for a specific part name like "Head" --
-- these creature rigs don't all name their head part the same way, which was why labels
-- were floating at chest height on some of them instead of above the head. Works the same
-- for the room-prop Events too, most of which aren't full character rigs at all.
local function GetVerticalHalfHeight(instance)
	if instance:IsA("Model") then
		local ok, _, size = pcall(function() return instance:GetBoundingBox() end)
		if ok and size and size.Y > 0 then return size.Y / 2 end
	elseif instance:IsA("BasePart") then
		return instance.Size.Y / 2
	end
	return 3
end

-- A short wait before measuring/adorning instead of reacting the instant the instance
-- shows up -- parts are still streaming in right when a model first appears, which was
-- actually behind ESP outlines silently never appearing on some NPCs.
local function CreateESPFor(instance)
	if espTracked[instance] or espPending[instance] then return end
	if not (instance:IsA("Model") or instance:IsA("BasePart")) then return end

		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.Parent = billboard

		local entry = {Highlight = highlight, Billboard = billboard, Label = label, Category = "unknown", CreatedAt = os.clock()}
		espTracked[instance] = entry

		entry.AncestryConn = instance.AncestryChanged:Connect(function(_, parent)

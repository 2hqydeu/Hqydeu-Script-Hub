-- ESP -----------------------------------------------------------------------------------
-- Patients and Visitors both carry a plain attribute; "Unique" covers the wildcard lobby
-- extras (Barney, the Clown, Officer Duckman, etc. -- confirmed as the UniqueVisitors
-- folder) that sometimes just chit-chat and sometimes turn out to be part of a jumpscare.
--
-- Anomalies split into two groups per testing: "Anomalies" are the ones that behave like
-- actual attacking NPCs (Ghost, Stalker, Tall Monster, Slimebert -- tracked the same way as
-- patients, through workspace.NPCs) vs. "Events", room-placed hazards/props (EyeMass,
-- Candles, Shadow, Hider, Bed Monster/Large) that never touch workspace.NPCs or carry the
-- "NPC" tag at all -- that's why EyeMass/MonsterBed never showed up before; they needed
-- their own workspace-wide watch, added below.
--
-- Disguised Threat (the patient-that-turns-out-to-attack-you case) traces back to
-- ReplicatedStorage.AnomalyEvents.DisguiseReveals. Four independent signals, OR'd together:
-- SkinwalkerOpensMouth.Apply() sets Transparency = 0 on {Gulp, Tooth, TongueMesh, Spit,
-- Teeth} (normally 1/hidden) -- confirmed by the visible Tooth/TongueMesh you spotted on
-- "Lucy Acorns". DifferentEars.Apply reveals a pre-built "SecondEars" child in place of the
-- normal "Ears" one -- a real patient never has that extra child at all, so its mere
-- presence is enough on its own, no reveal needed. DifferentFace.Apply swaps a face part's
-- TextureID (OriginalFace, present on every patient, is what it restores on UnDo) -- a face
-- that no longer matches its own OriginalFace has been swapped by some reveal effect. And
-- every mesh/texture ID you found directly on confirmed threats in testing is checked
-- against every part on the model. The reveal itself is also gated by a
-- "CameraEffect"/"PhotoEffect" Attribute read directly off the model -- since Attributes
-- replicate the moment they're set server-side, reading it directly should catch the
-- threat even before ever pointing a camera at them.
local ESP_PATIENT_COLOR = Color3.fromRGB(255, 255, 255)
local ESP_VISITOR_COLOR = Color3.fromRGB(80, 220, 100)
local ESP_ANOMALY_COLOR = Color3.fromRGB(255, 60, 60)
local ESP_EVENT_COLOR = Color3.fromRGB(190, 90, 255)
local ESP_UNIQUE_COLOR = Color3.fromRGB(255, 150, 40)
local ESP_UNKNOWN_COLOR = Color3.fromRGB(255, 210, 60)

local SKINWALKER_PARTS = {"Gulp", "Tooth", "TongueMesh", "Spit", "Teeth"}
local DISGUISE_ATTRIBUTES = {"CameraEffect", "CameraEffect2", "PhotoEffect", "PhotoEffect2"}
-- Every mesh/texture ID found directly on confirmed disguised NPCs in testing.
local KNOWN_DISGUISE_ASSET_IDS = {
	["rbxassetid://117344367007423"] = true,
	["rbxassetid://134031923875296"] = true,
	["rbxassetid://104746459518421"] = true,
	["rbxassetid://95314486238009"] = true,
	["rbxassetid://126271528392546"] = true,
	["rbxassetid://8666406942"] = true,
	["rbxassetid://125294235208418"] = true,
}

local function HasDisguiseAttribute(model)
	for _, attributeName in ipairs(DISGUISE_ATTRIBUTES) do
		if model:GetAttribute(attributeName) then return true end
	end
	return false
end

local function HasVisibleSkinwalkerParts(model)
	for _, partName in ipairs(SKINWALKER_PARTS) do
		local part = model:FindFirstChild(partName)
		if part and part:IsA("BasePart") and part.Transparency < 0.95 then
			return true
		end
	end
	return false
end

-- A real patient never has this extra child at all -- its mere presence is the tell, no
-- reveal needed first.
local function HasSecondEars(model)
	return model:FindFirstChild("SecondEars") ~= nil
end

-- Checked against every BasePart under the model (not just the obvious Head.002/Face)
-- since the known-bad IDs above span both mesh and ear assets, not just faces.
local function HasSwappedOrKnownBadAsset(model)
	local originalFace = model:GetAttribute("OriginalFace")
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local textureId = descendant.TextureID
			if textureId and textureId ~= "" then
				if KNOWN_DISGUISE_ASSET_IDS[textureId] then return true end
				if descendant.Name == "Head.002" and originalFace and originalFace ~= "" and textureId ~= originalFace then
					return true
				end
			end
			local meshId = descendant.MeshId
			if meshId and meshId ~= "" and KNOWN_DISGUISE_ASSET_IDS[meshId] then
				return true
			end
		end
	end
	return false
end

local function IsDisguisedThreat(model)
	return HasDisguiseAttribute(model)
		or HasVisibleSkinwalkerParts(model)
		or HasSecondEars(model)
		or HasSwappedOrKnownBadAsset(model)
end

-- Anomaly templates that behave like actual attacking NPCs -- tracked through
-- workspace.NPCs, same as patients.
local NPC_ANOMALY_NAMES = {
	TallMonster = true, TallMonster0 = true, TallMonster2 = true,
	TallMonsterFace = true, TallMonsterHead = true, Ghost = true, Skinwalker = true,
}
local ANOMALY_SIGNALS = {
	{label = "Ghost", tag = "GhostAnomaly"},
	{label = "Stalker", tag = "StalkerJumpscare"},
	{label = "Tall Monster", tag = "TallMonsterSpawn"},
	{label = "Slimebert", attribute = "IsSlimebert"},
}

-- Anomaly templates that are room-placed hazards/props instead -- never touch
-- workspace.NPCs, watched workspace-wide by name below.
local EVENT_ANOMALY_NAMES = {
	Shadow = true, EyeMass = true, Candles = true, Hider = true,
	MonsterBed = true, MonsterBedLarge = true,
}
local EVENT_ANOMALY_SIGNALS = {
	{label = "Shadow", tag = "AnomalyShadow"},
}

-- Named lobby extras from ReplicatedStorage.NPCs.UniqueVisitors -- checked by name as a
-- backup to the "Unique" tag in case that tag isn't reliably applied to all of them.
local UNIQUE_VISITOR_NAMES = {
	["Officer Duckman"] = true, ["Barney"] = true, ["Clown"] = true, ["DoctorOld"] = true,
	["Ratthew"] = true, ["Ron from Accounting"] = true, ["Liz"] = true, ["Doctor"] = true,
	["Hazmat"] = true, ["TinyGuy"] = true, ["Sam"] = true,
}

-- Returns label, color, and a category key (used by the ESP Options popup's per-category
-- toggles further down) -- checked most-dangerous-first so a Disguised Threat never gets
-- reported as a plain Patient just because it also happens to carry IsPatient.
local function ClassifyInstance(instance)
	if instance:IsA("Model") and IsDisguisedThreat(instance) then
		return "Disguised Threat", ESP_ANOMALY_COLOR, "disguise"
	end
	if NPC_ANOMALY_NAMES[instance.Name] then
		return instance.Name, ESP_ANOMALY_COLOR, "anomaly"
	end
	for _, signal in ipairs(ANOMALY_SIGNALS) do
		if signal.tag and instance:HasTag(signal.tag) then
			return signal.label, ESP_ANOMALY_COLOR, "anomaly"
		end
		if signal.attribute and instance:GetAttribute(signal.attribute) then
			return signal.label, ESP_ANOMALY_COLOR, "anomaly"
		end
	end
	if EVENT_ANOMALY_NAMES[instance.Name] then
		return instance.Name, ESP_EVENT_COLOR, "event"
	end
	for _, signal in ipairs(EVENT_ANOMALY_SIGNALS) do
		if signal.tag and instance:HasTag(signal.tag) then
			return signal.label, ESP_EVENT_COLOR, "event"
		end
	end
	if instance:GetAttribute("IsPatient") == true then
		return "Patient", ESP_PATIENT_COLOR, "patient"
	end
	if instance:GetAttribute("IsVisitor") == true then
		return "Visitor", ESP_VISITOR_COLOR, "visitor"
	end
	if instance:HasTag("Unique") or UNIQUE_VISITOR_NAMES[instance.Name] then
		return "Unique", ESP_UNIQUE_COLOR, "unique"
	end
	return "Unknown", ESP_UNKNOWN_COLOR, "unknown"
end

-- Per-category show/hide, wired up by the ESP Options popup further down -- declared this
-- early (before anything that reads it as an upvalue) since Lua locals only apply to code
-- after their own declaration in the same block.
local espShow = {patient = true, visitor = true, anomaly = true, event = true, unique = true, disguise = true, unknown = true}

local espEnabled = false
local espTracked = {} -- instance -> {Highlight, Billboard, Label, Category, AncestryConn}
local espPending = {} -- set of instances currently waiting to be measured/adorned

local function RemoveESPFrom(instance)
	espPending[instance] = nil
	local entry = espTracked[instance]
	if not entry then return end
	if entry.AncestryConn then entry.AncestryConn:Disconnect() end
	if entry.Highlight then entry.Highlight:Destroy() end
	if entry.Billboard then entry.Billboard:Destroy() end
	espTracked[instance] = nil
end

-- Bounding-box half-height instead of hunting for a specific part name like "Head" --
-- these creature rigs don't all name their head part the same way, which was why labels
-- were floating at chest height on some of them instead of above the head. Works the same
-- for the room-prop Events too, most of which aren't full character rigs at all.
local function GetVerticalHalfHeight(instance)
	if instance:IsA("Model") then
		local ok, _, size = pcall(function() return instance:GetBoundingBox() end)
		if ok and size and size.Y > 0 then return size.Y / 2 end
	elseif instance:IsA("BasePart") then
		return instance.Size.Y / 2
	end
	return 3
end

-- A short wait before measuring/adorning instead of reacting the instant the instance
-- shows up -- parts are still streaming in right when a model first appears, which was
-- actually behind ESP outlines silently never appearing on some NPCs.
local function CreateESPFor(instance)
	if espTracked[instance] or espPending[instance] then return end
	if not (instance:IsA("Model") or instance:IsA("BasePart")) then return end
	espPending[instance] = true

	task.spawn(function()
		task.wait(0.15)
		espPending[instance] = nil
		if not espEnabled or not instance.Parent or espTracked[instance] then return end

		local highlight = Instance.new("Highlight")
		highlight.Name = "SerenityESP"
		highlight.FillTransparency = 1
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = instance
		highlight.Parent = instance

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "SerenityESPLabel"
		billboard.Adornee = instance
		billboard.Size = UDim2.new(0, 160, 0, 24)
		billboard.StudsOffset = Vector3.new(0, GetVerticalHalfHeight(instance) + 0.6, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = instance

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = UIFont
		label.TextSize = 16
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.Parent = billboard

		local entry = {Highlight = highlight, Billboard = billboard, Label = label, Category = "unknown"}
		espTracked[instance] = entry

		entry.AncestryConn = instance.AncestryChanged:Connect(function(_, parent)
			if not parent then RemoveESPFrom(instance) end
		end)
	end)
end

local function ApplyESPVisibility()
	for _, entry in pairs(espTracked) do
		local visible = espShow[entry.Category] ~= false
		entry.Highlight.Enabled = visible
		entry.Billboard.Enabled = visible
	end
end

-- Classification can change after an instance is already tracked (patients gain IsPatient
-- once checked in, a threat's reveal signals can appear later), so this re-checks
-- everything tracked on a light throttle instead of wiring per-attribute signals for each
-- one -- simpler, and cheap at the handful of NPCs/props this game has active at once.
local lastClassifyPass = 0
local function RefreshESPClassifications()
	local now = os.clock()
	if now - lastClassifyPass < 0.25 then return end
	lastClassifyPass = now
	for instance, entry in pairs(espTracked) do
		if instance.Parent then
			local classification, color, category = ClassifyInstance(instance)
			if entry.Label.Text ~= classification then
				entry.Label.Text = classification
				entry.Label.TextColor3 = color
				entry.Highlight.OutlineColor = color
			end
			entry.Category = category
			local visible = espShow[category] ~= false
			entry.Highlight.Enabled = visible
			entry.Billboard.Enabled = visible
		end
	end
end

-- Primary tracking is the actual workspace.NPCs folder every patient/visitor/NPC-style
-- anomaly gets parented into on spawn, watched for real-time add. Deliberately NOT watching
-- ChildRemoved on that folder -- a patient moving into a bed (or any other in-folder
-- reparent) fires ChildRemoved without the NPC actually being gone, which was exactly why
-- ESP outlines kept vanishing on patients lying down. Real cleanup happens once, uniformly,
-- via each tracked instance's own AncestryChanged connection in CreateESPFor (parent
-- becoming nil = actually destroyed), regardless of which folder momentarily held it. The
-- CollectionService "NPC"/"Unique" tags are watched too, as a fallback for anything tagged
-- but not actually parented under that folder. Event anomalies are room props that never
-- touch workspace.NPCs or that tag at all, so they get their own workspace-wide watch.
local watchConnections = {}
local function StartESP()
	local npcFolder = workspace:FindFirstChild("NPCs")
	if npcFolder then
		for _, child in ipairs(npcFolder:GetChildren()) do
			CreateESPFor(child)
		end
		table.insert(watchConnections, npcFolder.ChildAdded:Connect(CreateESPFor))
	end
	for _, tagName in ipairs({"NPC", "Unique"}) do
		for _, model in ipairs(CollectionService:GetTagged(tagName)) do
			CreateESPFor(model)
		end
		table.insert(watchConnections, CollectionService:GetInstanceAddedSignal(tagName):Connect(CreateESPFor))
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if EVENT_ANOMALY_NAMES[descendant.Name] then CreateESPFor(descendant) end
	end
	table.insert(watchConnections, workspace.DescendantAdded:Connect(function(descendant)
		if EVENT_ANOMALY_NAMES[descendant.Name] then CreateESPFor(descendant) end
	end))
end

local function StopESP()
	for _, connection in ipairs(watchConnections) do connection:Disconnect() end
	watchConnections = {}
	espPending = {}
	for instance in pairs(espTracked) do RemoveESPFrom(instance) end
end


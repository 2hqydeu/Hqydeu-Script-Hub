-- Small shared polish helpers -- hover brighten, a tactile press-down "squish", and a
-- divider that fades out at both ends instead of a flat bar. Same visual pass as the main
-- hub, ported here for a consistent feel across every panel.
local function GetOrCreateUIScale(target)
	local scale = target:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = target
	end
	return scale
end

local function AddPressBounce(button)
	local scale = GetOrCreateUIScale(button)
	local pressed = false
	local function release()
		if not pressed then return end
		pressed = false
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
	end
	button.MouseButton1Down:Connect(function()
		pressed = true
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.8}):Play()
	end)
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
end

local function AddFadeDivider(divider)
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = divider
end


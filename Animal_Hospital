	task.spawn(function()
		task.wait(0.15)
		espPending[instance] = nil
		if not espEnabled or not instance.Parent or espTracked[instance] then return end

		local highlight = Instance.new("Highlight")
		highlight.Name = "SerenityESP"
		highlight.FillTransparency = 1
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = instance
		highlight.Parent = instance

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "SerenityESPLabel"
		billboard.Adornee = instance
		billboard.Size = UDim2.new(0, 160, 0, 24)
		billboard.StudsOffset = Vector3.new(0, GetVerticalHalfHeight(instance) + 0.6, 0)
		billboard.AlwaysOnTop = true

-- ESP -----------------------------------------------------------------------------------
-- Patients and Visitors both carry a plain attribute; a few anomaly types carry their own
-- persistent tag; most of ReplicatedStorage.NPCs.Anomalies' templates get cloned into
-- workspace.NPCs without a randomized name (unlike patients), so the model's own .Name
-- usually still matches its template name directly. "Unique" covers the wildcard lobby
-- extras (Barney, the Clown, Officer Duckman, etc. -- confirmed as the UniqueVisitors
-- folder) that sometimes just chit-chat and sometimes turn out to be part of a jumpscare.
--
-- Disguised Threat (the patient-that-turns-out-to-attack-you case) traces back to
-- ReplicatedStorage.AnomalyEvents.DisguiseReveals -- reading SkinwalkerOpensMouth's own
-- Apply() confirms it sets Transparency = 0 on exactly {Gulp, Tooth, TongueMesh, Spit,
-- Teeth} (normally 1, i.e. hidden) -- the literal mechanism behind the visible
-- Tooth/TongueMesh spotted on "Lucy Acorns" in testing. That reveal itself is gated by a
-- "CameraEffect"/"PhotoEffect" Attribute read directly off the model in
-- AnomalyEvents.Local's ApplyDisguiseReveal -- since Attributes replicate the moment
-- they're set server-side, reading it directly should catch the threat even before ever
-- pointing a camera at them, which the three checks below are built around. All three are
-- OR'd together so any one of them catching it is enough to flag it.
local ESP_PATIENT_COLOR = Color3.fromRGB(255, 255, 255)
local ESP_VISITOR_COLOR = Color3.fromRGB(80, 220, 100)
local ESP_ANOMALY_COLOR = Color3.fromRGB(255, 60, 60)
local ESP_UNIQUE_COLOR = Color3.fromRGB(255, 150, 40)
local ESP_UNKNOWN_COLOR = Color3.fromRGB(255, 210, 60)

local SKINWALKER_PARTS = {"Gulp", "Tooth", "TongueMesh", "Spit", "Teeth"}
local DISGUISE_ATTRIBUTES = {"CameraEffect", "CameraEffect2", "PhotoEffect", "PhotoEffect2"}
-- The two face TextureIDs you found directly on the real disguised NPC in testing --
-- checked in addition to (not instead of) the general "doesn't match OriginalFace" check
-- below, in case OriginalFace itself is ever missing/not set for some reason.
local KNOWN_DISGUISE_FACE_IDS = {
	["rbxassetid://117344367007423"] = true,
	["rbxassetid://134031923875296"] = true,
}

local function HasDisguiseAttribute(model)
	for _, attributeName in ipairs(DISGUISE_ATTRIBUTES) do
		if model:GetAttribute(attributeName) then return true end
	end
	return false
end

local function HasVisibleSkinwalkerParts(model)
	for _, partName in ipairs(SKINWALKER_PARTS) do
		local part = model:FindFirstChild(partName)
		if part and part:IsA("BasePart") and part.Transparency < 0.95 then
			return true
		end
	end
	return false
end

-- DifferentFace.Apply swaps a face MeshPart's TextureID and stashes the new value under a
-- "SecondFace" attribute -- OriginalFace (present on every patient) is what it restores on
-- UnDo, so a face that no longer matches its own OriginalFace has been swapped by *some*
-- reveal effect, not just this specific one.
local function HasSwappedOrKnownBadFace(model)
	local facePart = model:FindFirstChild("Head.002") or model:FindFirstChild("Face")
	if not facePart or not facePart:IsA("BasePart") then return false end
	local textureId = facePart.TextureID
	if not textureId or textureId == "" then return false end
	if KNOWN_DISGUISE_FACE_IDS[textureId] then return true end
	local originalFace = model:GetAttribute("OriginalFace")
	return originalFace ~= nil and originalFace ~= "" and textureId ~= originalFace
end

local function IsDisguisedThreat(model)
	return HasDisguiseAttribute(model) or HasVisibleSkinwalkerParts(model) or HasSwappedOrKnownBadFace(model)
end

-- Every child of ReplicatedStorage.NPCs.Anomalies, confirmed directly from the place file
-- (Skinwalker included, from the neighboring Skinwalkers folder, as cheap defensive
-- coverage even though the real one almost certainly runs around under a disguised human
-- name instead).
local ANOMALY_NAMES = {
	Shadow = true, EyeMass = true, Candles = true, TallMonster2 = true, TallMonster0 = true,
	TallMonsterFace = true, MonsterBedLarge = true, TallMonsterHead = true, Hider = true,
	TallMonster = true, MonsterBed = true, Ghost = true, Skinwalker = true,
}

-- Confirmed persistent identity tags/attributes (found directly in the game's own scripts)
-- for the subset of anomaly types that carry one -- checked in addition to the name match
-- above since a tag survives even if something ever renames the model.
local ANOMALY_SIGNALS = {
	{label = "Ghost", tag = "GhostAnomaly"},
	{label = "Shadow", tag = "AnomalyShadow"},
	{label = "Stalker", tag = "StalkerJumpscare"},
	{label = "Tall Monster", tag = "TallMonsterSpawn"},
	{label = "Slimebert", attribute = "IsSlimebert"},
}

-- Named lobby extras from ReplicatedStorage.NPCs.UniqueVisitors -- checked by name as a
-- backup to the "Unique" tag in case that tag isn't reliably applied to all of them.
local UNIQUE_VISITOR_NAMES = {
	["Officer Duckman"] = true, ["Barney"] = true, ["Clown"] = true, ["DoctorOld"] = true,
	["Ratthew"] = true, ["Ron from Accounting"] = true, ["Liz"] = true, ["Doctor"] = true,
	["Hazmat"] = true, ["TinyGuy"] = true, ["Sam"] = true,
}

local function ClassifyNPC(model)
	if IsDisguisedThreat(model) then
		return "Disguised Threat", ESP_ANOMALY_COLOR
	end
	if ANOMALY_NAMES[model.Name] then
		return model.Name, ESP_ANOMALY_COLOR
	end
	for _, signal in ipairs(ANOMALY_SIGNALS) do
		if signal.tag and model:HasTag(signal.tag) then
			return signal.label, ESP_ANOMALY_COLOR
		end
		if signal.attribute and model:GetAttribute(signal.attribute) then
			return signal.label, ESP_ANOMALY_COLOR
		end
	end
	if model:GetAttribute("IsPatient") == true then
		return "Patient", ESP_PATIENT_COLOR
	end
	if model:GetAttribute("IsVisitor") == true then
		return "Visitor", ESP_VISITOR_COLOR
	end
	if model:HasTag("Unique") or UNIQUE_VISITOR_NAMES[model.Name] then
		return "Unique", ESP_UNIQUE_COLOR
	end
	return "Unknown", ESP_UNKNOWN_COLOR
end

local espEnabled = false
local espTracked = {} -- model -> {Highlight, Billboard, Label, AncestryConn}
local espPending = {} -- set of models currently waiting on a not-yet-loaded body part

local function RemoveESPFromModel(model)
	espPending[model] = nil
	local entry = espTracked[model]
	if not entry then return end
	if entry.AncestryConn then entry.AncestryConn:Disconnect() end
	if entry.Highlight then entry.Highlight:Destroy() end
	if entry.Billboard then entry.Billboard:Destroy() end
	espTracked[model] = nil
end

-- Head/HumanoidRootPart sometimes isn't loaded yet the instant a model shows up
-- (streaming/character-building still in progress) -- waiting briefly instead of giving up
-- immediately is what was actually behind ESP silently never appearing on some NPCs.
local function AddESPToModel(model)
	if not model:IsA("Model") or espTracked[model] or espPending[model] then return end
	espPending[model] = true

	task.spawn(function()
		local adornPart = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		if not adornPart then
			adornPart = model:WaitForChild("HumanoidRootPart", 5) or model:FindFirstChild("Head")
		end
		espPending[model] = nil
		-- Bail if ESP got toggled off, the model got removed, or something else already
		-- claimed it while this was waiting.
		if not espEnabled or not model.Parent or not adornPart or espTracked[model] then return end

		local highlight = Instance.new("Highlight")
		highlight.Name = "SerenityESP"
		highlight.FillTransparency = 1
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = model
		highlight.Parent = model

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "SerenityESPLabel"
		billboard.Adornee = adornPart
		billboard.Size = UDim2.new(0, 160, 0, 24)
		billboard.StudsOffset = Vector3.new(0, 1.6, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = model

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = UIFont
		label.TextSize = 16
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.Parent = billboard

		local entry = {Highlight = highlight, Billboard = billboard, Label = label}
		espTracked[model] = entry

		entry.AncestryConn = model.AncestryChanged:Connect(function(_, parent)
			if not parent then RemoveESPFromModel(model) end
		end)
	end)
end

-- Classification can change after a model's already tracked (patients gain IsPatient once
-- checked in, an anomaly type's tag can get added after it activates), so this re-checks
-- every tracked model on a light throttle instead of wiring per-attribute signals for each
-- one -- simpler, and cheap at the handful of NPCs this game has active at once.
local lastClassifyPass = 0
local function RefreshESPClassifications()
	local now = os.clock()
	if now - lastClassifyPass < 0.25 then return end
	lastClassifyPass = now
	for model, entry in pairs(espTracked) do
		if model.Parent then
			local classification, color = ClassifyNPC(model)
			if entry.Label.Text ~= classification then
				entry.Label.Text = classification
				entry.Label.TextColor3 = color
				entry.Highlight.OutlineColor = color
			end
		end
	end
end

-- Primary tracking is the actual workspace.NPCs folder every patient/visitor/anomaly gets
-- parented into on spawn (confirmed directly in the place file, and matches what you saw
-- in-game) -- ChildAdded/ChildRemoved catches new arrivals and departures in real time,
-- which the tag-only approach this started with apparently wasn't doing reliably. The
-- CollectionService "NPC"/"Unique" tags are watched too, as a fallback for anything tagged
-- but not actually parented under that folder (the wildcard extras in particular may live
-- somewhere else).
local watchConnections = {}
local function StartESP()
	local npcFolder = workspace:FindFirstChild("NPCs")
	if npcFolder then
		for _, child in ipairs(npcFolder:GetChildren()) do
			AddESPToModel(child)
		end
		table.insert(watchConnections, npcFolder.ChildAdded:Connect(AddESPToModel))
		table.insert(watchConnections, npcFolder.ChildRemoved:Connect(RemoveESPFromModel))
	end
	for _, tagName in ipairs({"NPC", "Unique"}) do
		for _, model in ipairs(CollectionService:GetTagged(tagName)) do
			AddESPToModel(model)
		end
		table.insert(watchConnections, CollectionService:GetInstanceAddedSignal(tagName):Connect(AddESPToModel))
		table.insert(watchConnections, CollectionService:GetInstanceRemovedSignal(tagName):Connect(RemoveESPFromModel))
	end
end

local function StopESP()
	for _, connection in ipairs(watchConnections) do connection:Disconnect() end
	watchConnections = {}
	espPending = {}
	for model in pairs(espTracked) do RemoveESPFromModel(model) end
end

RunService.Heartbeat:Connect(function()
	if not ScreenGui.Parent or not espEnabled then return end
	RefreshESPClassifications()
end)

ESPToggle.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	ESPToggle.Text = espEnabled and "On" or "Off"
	if espEnabled then StartESP() else StopESP() end
end)

-- Minimize: shrinks to just the header, matching Serenity's own minimize behavior. Every
-- row lives inside ContentScroll now, so hiding that one frame is enough.
local minimized = false
local function ToggleMinimize()
	minimized = not minimized
	HeaderDivider.Visible = not minimized
	ContentScroll.Visible = not minimized
	PanelFrame.Size = UDim2.new(0, 280, 0, minimized and MINI_HEIGHT or FULL_HEIGHT)
end
MinimizeButton.MouseButton1Click:Connect(ToggleMinimize)

-- Plays the reverse of the open animation (pop + fade out) before actually destroying,
-- instead of just vanishing -- debounced so a double-click mid-fade can't fire this twice.
local closingPanel = false
CloseButton.MouseButton1Click:Connect(function()
	if closingPanel then return end
	closingPanel = true
	StopESP()
	local fadeOutInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(PanelScale, fadeOutInfo, {Scale = 0.85}):Play()
	local fadeOutTween = TweenService:Create(PanelFrame, fadeOutInfo, {BackgroundTransparency = 1})
	fadeOutTween:Play()
	fadeOutTween.Completed:Wait()
	ScreenGui:Destroy()
end)

-- Dragging
local dragging = false
local dragStart = nil
local startPos = nil
PanelFrame.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	dragging = true
	dragStart = input.Position
	startPos = PanelFrame.Position
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			dragging = false
		end
	end)
end)
UserInputService.InputChanged:Connect(function(input)
	if not dragging or (input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch) then return end
	local delta = input.Position - dragStart
	PanelFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	getgenv().Serenity_AH_PanelPosition = PanelFrame.Position
end)

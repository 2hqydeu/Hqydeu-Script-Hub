-- Confirmed structure (from your live paths + a save instance): each Medical room has
-- workspace.Rooms.Medical.<Room>.Minigame.Monitor -- pressing its "PP2" prompt ("Process
-- Results") kicks off analysis; once it finishes, Screen.UI.Report.race and .illnesses
-- (TextLabels) show the patient's name and diagnosed illness list, one per line, dash-
-- prefixed ("- Dried Eyes"). The patient's own model carries a "PP" ProximityPrompt
-- ("Apply Treatment") for giving a cure once the right one is equipped. Cure items are
-- picked up from Model instances scattered around the map (each named after the cure,
-- each with its own "PP" prompt) -- there's no single fixed shelf, so these are found by a
-- workspace-wide name search instead of any hardcoded path. The illness->cure mapping
-- below is copied directly from the game's own IllnessesAndCures module.
local ILLNESS_CURES = {
	["Dehydration"] = "IV Drops",
	["Stomach Ache"] = "Herbs",
	["Head Ache"] = "Medicine",
	["Bleeding"] = "Bandages",
	["Fever"] = "Thermo",
	["Low Sugar"] = "Maple Syrup",
	["Canadian"] = "Maple Syrup",
	["Flu"] = "Cough Syrup",
	["Rash"] = "Ointment",
	["Dried Eyes"] = "Eye Drops",
	["Bruises"] = "Medkit",
}

-- Same trick as Instant Prompt in the main hub -- HoldDuration/RequiresLineOfSight zeroed
-- on every prompt while Auto Treat is on, restored on toggle-off. Built in here rather
-- than relying on Main's own copy since this module runs as a fully separate script.
local autoTreatOriginalPromptValues = {}
local function RememberPromptOriginal(prompt)
	if not autoTreatOriginalPromptValues[prompt] then
		autoTreatOriginalPromptValues[prompt] = {HoldDuration = prompt.HoldDuration, RequiresLineOfSight = prompt.RequiresLineOfSight}
	end
end
local function InstantifyPrompt(prompt)
	RememberPromptOriginal(prompt)
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false
end
local autoTreatPromptAddedConnection = nil
local function SetAutoTreatInstantPrompts(enabled)
	if enabled then
		for _, object in ipairs(workspace:GetDescendants()) do
			if object:IsA("ProximityPrompt") then InstantifyPrompt(object) end
		end
		autoTreatPromptAddedConnection = workspace.DescendantAdded:Connect(function(object)
			if object:IsA("ProximityPrompt") then InstantifyPrompt(object) end
		end)
	else
		if autoTreatPromptAddedConnection then
			autoTreatPromptAddedConnection:Disconnect()
			autoTreatPromptAddedConnection = nil
		end
		for prompt, original in pairs(autoTreatOriginalPromptValues) do
			if prompt.Parent then
				prompt.HoldDuration = original.HoldDuration
				prompt.RequiresLineOfSight = original.RequiresLineOfSight
			end
		end
		autoTreatOriginalPromptValues = {}
	end
end

local function GetPlayerRoot()
	local character = Player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

-- Same straight-reposition approach already used for the Base TP button on this panel and
-- for Auto Farm-style automation elsewhere in this hub -- not real pathfinding. Faces the
-- character toward the target (in first person the camera follows head orientation, and a
-- prompt sitting off-screen apparently can't be pressed at all) and fully zeroes both
-- linear AND angular velocity. Doesn't bother returning the character to where it was after
-- -- confirmed as a non-issue, so this just parks it right at the target instead.
local function TeleportFacing(targetPosition, standoffDistance)
	local root = GetPlayerRoot()
	if not root then return nil end
	local originalCFrame = root.CFrame
	local flatOffset = originalCFrame.Position - targetPosition
	flatOffset = Vector3.new(flatOffset.X, 0, flatOffset.Z)
	if flatOffset.Magnitude < 0.5 then flatOffset = Vector3.new(0, 0, 1) end
	local standPosition = targetPosition + flatOffset.Unit * (standoffDistance or 4)
	root.CFrame = CFrame.new(standPosition, Vector3.new(targetPosition.X, standPosition.Y, targetPosition.Z))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return originalCFrame
end

-- fireproximityprompt alone turned out to not reliably register server-side (confirmed --
-- pressing E manually in the exact same spot the script had already positioned/equipped
-- worked every time) -- simulating the prompt's actual bound key (E by default, but read
-- directly off the prompt in case it's rebound) goes through the same input pipeline a real
-- press does, which a real press proved the server actually honors.
local function GetPromptKeyCode(prompt)
	local keyCode = prompt.KeyboardKeyCode
	if keyCode and keyCode ~= Enum.KeyCode.Unknown then return keyCode end
	return Enum.KeyCode.E
end

local function SimulatePromptKeyPress(prompt)
	local keyCode = GetPromptKeyCode(prompt)
	pcall(function() VirtualInputManager:SendKeyEvent(true, keyCode, false, game) end)
	task.wait(0.1)
	pcall(function() VirtualInputManager:SendKeyEvent(false, keyCode, false, game) end)
end

-- No fixed shelf path -- finds every Model in the workspace named after this cure (a
-- pickup spot always carries its own "PP" prompt) and returns the closest one to the
-- player, wherever it actually is.
local function FindClosestCureModel(cureName, fromPosition)
	local closest, closestDistance = nil, math.huge
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Model") and descendant.Name == cureName and descendant:FindFirstChild("PP") then
			local pivot = descendant:GetPivot().Position
			local distance = (pivot - fromPosition).Magnitude
			if distance < closestDistance then
				closestDistance = distance
				closest = descendant
			end
		end
	end
	return closest
end

local function GetBackpack()
	return Player:FindFirstChildOfClass("Backpack")
end

local function HasCureInInventory(cureName)
	local character = Player.Character
	local backpack = GetBackpack()
	return (character and character:FindFirstChild(cureName) ~= nil) or (backpack and backpack:FindFirstChild(cureName) ~= nil)
end

-- Teleports to face the target once, then retries firing in place -- both
-- fireproximityprompt and a simulated real key press, since the latter is what's actually
-- confirmed to register.
local function FirePromptNear(targetPosition, prompt, checkSuccess, attempts, perAttemptWait)
	attempts = attempts or 3
	perAttemptWait = perAttemptWait or 1.5
	TeleportFacing(targetPosition)
	task.wait(0.4)
	for _ = 1, attempts do
		if type(fireproximityprompt) == "function" then
			pcall(fireproximityprompt, prompt)
		end
		SimulatePromptKeyPress(prompt)
		if not checkSuccess then return true end
		local deadline = os.clock() + perAttemptWait
		while os.clock() < deadline do
			if checkSuccess() then return true end
			task.wait(0.15)
		end
	end
	return checkSuccess and checkSuccess() or false
end

-- Walks to the pickup spot and fires its prompt (retrying/waiting as needed for the Tool
-- to actually show up in the backpack).
local function FetchCure(cureName)
	if HasCureInInventory(cureName) then return true end
	local root = GetPlayerRoot()
	if not root then return false end
	local model = FindClosestCureModel(cureName, root.Position)
	if not model then return false end
	local prompt = model:FindFirstChild("PP")
	if not (prompt and prompt:IsA("ProximityPrompt")) then return false end
	return FirePromptNear(model:GetPivot().Position, prompt, function() return HasCureInInventory(cureName) end, 4, 1.5)
end

-- Equips the requested cure, confirming it actually landed (character:FindFirstChild
-- returning it isn't guaranteed the instant after EquipTool -- polling for it, then giving
-- it a bit more time to settle, instead of just assuming a fixed 0.2s was enough) --
-- firing "Apply Treatment" while the server hasn't actually seen the equip yet would fail
-- for the same reason on every single retry, no matter how many attempts FirePromptNear
-- gets, since the real precondition was never actually satisfied.
local function EquipCure(character, humanoid, cureName)
	if character:FindFirstChild(cureName) then return true end
	local backpack = GetBackpack()
	local tool = backpack and backpack:FindFirstChild(cureName)
	if not tool then return false end
	humanoid:EquipTool(tool)
	local deadline = os.clock() + 2
	while os.clock() < deadline do
		if character:FindFirstChild(cureName) then
			task.wait(0.4)
			return true
		end
		task.wait(0.1)
	end
	return character:FindFirstChild(cureName) ~= nil
end

-- Equips the given cure (from Backpack or already-equipped) and fires the patient's own
-- "Apply Treatment" prompt -- a plain prompt press same as picking the items up in the
-- first place, per your own testing, so this uses the same multiple-quick-attempts pattern
-- as FetchCure instead of the long single wait it had before (that was based on a
-- misread -- the two-sound gate turned out to be about the report actually finishing its
-- reveal, handled by WaitForReportSettled above, not about this prompt specifically).
local function ApplyCureToPatient(patient, cureName)
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	if not EquipCure(character, humanoid, cureName) then return false end
	local prompt = patient:FindFirstChild("PP")
	if not (prompt and prompt:IsA("ProximityPrompt")) then return false end
	return FirePromptNear(patient:GetPivot().Position, prompt, function() return not HasCureInInventory(cureName) end, 5, 1.5)
end

-- Inventory capacity: 3 slots for now (no reading of real capacity-upgrade state yet --
-- flagged as a fixed assumption, not a confirmed value). Anything carried that ISN'T one
-- of the cures currently needed is fair game to trash to make room.
local MAX_CARRY_ITEMS = 3

local function GetCarriedToolNames()
	local names = {}
	local backpack = GetBackpack()
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then table.insert(names, tool.Name) end
		end
	end
	local character = Player.Character
	local equipped = character and character:FindFirstChildOfClass("Tool")
	if equipped then table.insert(names, equipped.Name) end
	return names
end

local function CountCarriedItems()
	return #GetCarriedToolNames()
end

-- Same "no fixed path, search by name" approach as the cure pickups -- multiple trashcans
-- (each a Model named "Trash" with its own "PP" prompt) are scattered around the map.
local function FindClosestTrashCan(fromPosition)
	local closest, closestDistance = nil, math.huge
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Model") and descendant.Name == "Trash" and descendant:FindFirstChild("PP") then
			local pivot = descendant:GetPivot().Position
			local distance = (pivot - fromPosition).Magnitude
			if distance < closestDistance then
				closestDistance = distance
				closest = descendant
			end
		end
	end
	return closest
end

local function TrashTool(toolName)
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	local tool = character:FindFirstChild(toolName)
	if not tool then
		local backpack = GetBackpack()
		tool = backpack and backpack:FindFirstChild(toolName)
		if not tool then return false end
		humanoid:EquipTool(tool)
		task.wait(0.2)
	end
	local root = GetPlayerRoot()
	if not root then return false end
	local trashCan = FindClosestTrashCan(root.Position)
	if not trashCan then return false end
	local prompt = trashCan:FindFirstChild("PP")
	if not (prompt and prompt:IsA("ProximityPrompt")) then return false end
	return FirePromptNear(trashCan:GetPivot().Position, prompt, function() return not HasCureInInventory(toolName) end, 3, 1.5)
end

-- Frees enough inventory space for whatever cures are still missing before fetching starts
-- -- otherwise a fetch that would overflow the 3-slot cap either fails outright or silently
-- doesn't pick anything up.
local function MakeRoomForCures(cureNames)
	local stillNeeded = 0
	local keepSet = {}
	for _, cureName in ipairs(cureNames) do
		keepSet[cureName] = true
		if not HasCureInInventory(cureName) then stillNeeded = stillNeeded + 1 end
	end
	local overflow = (CountCarriedItems() + stillNeeded) - MAX_CARRY_ITEMS
	if overflow <= 0 then return end
	for _, toolName in ipairs(GetCarriedToolNames()) do
		if overflow <= 0 then break end
		if not keepSet[toolName] then
			if TrashTool(toolName) then
				overflow = overflow - 1
			end
		end
	end
end

-- Auto Treat being on already means "yes, treat" -- no separate confirmation, straight to
-- fetching once a new diagnosis shows up.
-- autoTreatGeneration bumps every Start/Stop -- RunAutoTreat's background sequence checks
-- it (and autoTreatEnabled) between every step, so turning the feature off actually
-- interrupts a treatment already in progress instead of letting it run to completion
-- regardless, which is what it was doing before.
local autoTreatEnabled = false
local autoTreatGeneration = 0

-- roomInfo.startPrompt/startPosition (if present) is a Room8-style bed prompt that needs
-- firing once to actually begin treatment before the patient's own prompt does anything --
-- see WatchMedicalRoom below for how that's detected.
local function RunAutoTreat(patient, cureNames, roomInfo)
	local myGeneration = autoTreatGeneration
	local function stillActive()
		return autoTreatEnabled and autoTreatGeneration == myGeneration
	end
	task.spawn(function()
		if not stillActive() then return end
		MakeRoomForCures(cureNames)
		if not stillActive() then return end
		if roomInfo and roomInfo.startPrompt then
			FirePromptNear(roomInfo.startPosition, roomInfo.startPrompt, nil, 2, 1)
			if not stillActive() then return end
		end
		for _, cureName in ipairs(cureNames) do
			if not stillActive() then return end
			FetchCure(cureName)
		end
		if not stillActive() then return end
		if patient.Parent then
			for _, cureName in ipairs(cureNames) do
				if not stillActive() then return end
				if HasCureInInventory(cureName) then
					ApplyCureToPatient(patient, cureName)
				end
			end
		end
	end)
end

-- Parses "- Dried Eyes\n- Fever" style report text into a deduplicated list of the cure
-- items needed, skipping any illness this hub doesn't have a mapping for rather than
-- guessing.
local function ParseNeededCures(illnessesText)
	local seen = {}
	local cures = {}
	for line in illnessesText:gmatch("[^\r\n]+") do
		local illnessName = line:gsub("^%s*-%s*", ""):gsub("^%s+", ""):gsub("%s+$", "")
		local cureName = ILLNESS_CURES[illnessName]
		if cureName and not seen[cureName] then
			seen[cureName] = true
			table.insert(cures, cureName)
		end
	end
	return cures
end

-- Confirmed sound (found directly by you) that plays twice as part of the report actually
-- revealing -- once before the items start showing, again once the reveal finishes, and
-- only after that second play are you actually able to treat. Watched here instead of
-- guessing a fixed duration. Layered with a plain "text stopped changing" debounce as a
-- fallback in case the sound doesn't show up where expected, capped by an overall timeout
-- so this can never hang forever either way.
local TREAT_READY_SOUND_ID = "rbxassetid://18466265279"
local function WaitForReportSettled(illnessesLabel, minigame)
	local lastChangeAt = os.clock()
	local soundPlays = 0
	local connections = {}

	local function watchSound(sound)
		if sound.SoundId ~= TREAT_READY_SOUND_ID then return end
		table.insert(connections, sound.Ended:Connect(function()
			soundPlays = soundPlays + 1
		end))
	end
	if minigame then
		for _, descendant in ipairs(minigame:GetDescendants()) do
			if descendant:IsA("Sound") then watchSound(descendant) end
		end
		table.insert(connections, minigame.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("Sound") then watchSound(descendant) end
		end))
	end
	table.insert(connections, illnessesLabel:GetPropertyChangedSignal("Text"):Connect(function()
		lastChangeAt = os.clock()
	end))

	local deadline = os.clock() + 12
	while os.clock() < deadline do
		if soundPlays >= 2 then break end
		if os.clock() - lastChangeAt >= 1.5 then break end
		task.wait(0.1)
	end

	for _, connection in ipairs(connections) do connection:Disconnect() end
	return illnessesLabel.Text
end

-- One room, watched for its Report.illnesses text changing to a new non-empty diagnosis.
-- Works for both Medical and Emergency wings alike (see StartAutoTreat) -- Emergency's
-- Printer ("Print Badge") is a different first step than Medical's Monitor ("Process
-- Results"), but per your own testing the same Monitor/Report structure reveals the
-- diagnosis afterward either way, so this doesn't need to know or care which room type
-- it's watching.
local roomLastIllnessText = {}
local function WatchMedicalRoom(room)
	local minigame = room:FindFirstChild("Minigame")
	local monitor = minigame and minigame:FindFirstChild("Monitor")
	local screen = monitor and monitor:FindFirstChild("Screen")
	local ui = screen and screen:FindFirstChild("UI")
	local report = ui and ui:FindFirstChild("Report")
	local illnessesLabel = report and report:FindFirstChild("illnesses")
	local raceLabel = report and report:FindFirstChild("race")
	if not (illnessesLabel and raceLabel) then return end

	-- Room8-style "waves" rooms additionally need their bed's PP2 fired once to actually
	-- begin treatment (potentially needing up to ~10 items across the whole sequence) --
	-- detected structurally (does this room's Bed.InBed have a PP2?) rather than by room
	-- name, so this works for any room built the same way, not just Room8 specifically.
	local bed = minigame:FindFirstChild("Bed")
	local inBed = bed and bed:FindFirstChild("InBed")
	local startPrompt = inBed and inBed:FindFirstChild("PP2")
	local startPosition = startPrompt and inBed:GetPivot().Position

	local processing = false
	illnessesLabel:GetPropertyChangedSignal("Text"):Connect(function()
		if not autoTreatEnabled or processing then return end
		local text = illnessesLabel.Text
		if text == "" or text == roomLastIllnessText[room] then return end
		processing = true
		task.spawn(function()
			-- The report fills in gradually rather than appearing all at once -- this waits
			-- for it to actually finish before reading it as the real diagnosis, instead of
			-- reacting to the first (incomplete) change.
			local settledText = WaitForReportSettled(illnessesLabel, minigame)
			processing = false
			if not autoTreatEnabled then return end
			if settledText == "" or settledText == roomLastIllnessText[room] then return end
			roomLastIllnessText[room] = settledText
			local patientName = raceLabel.Text
			if not patientName or patientName == "" then return end
			local npcFolder = workspace:FindFirstChild("NPCs")
			local patient = npcFolder and npcFolder:FindFirstChild(patientName)
			if not patient then return end
			local cures = ParseNeededCures(settledText)
			if #cures == 0 then return end
			local roomInfo = startPrompt and {startPrompt = startPrompt, startPosition = startPosition} or nil
			RunAutoTreat(patient, cures, roomInfo)
		end)
	end)
end

local autoTreatWingWatchConnections = {}
local function StartAutoTreat()
	roomLastIllnessText = {}
	autoTreatGeneration = autoTreatGeneration + 1
	SetAutoTreatInstantPrompts(true)
	local roomsFolder = workspace:FindFirstChild("Rooms")
	if not roomsFolder then return end
	local function WatchWing(wingName)
		local wing = roomsFolder:FindFirstChild(wingName)
		if not wing then return end
		for _, room in ipairs(wing:GetChildren()) do
			WatchMedicalRoom(room)
		end
		table.insert(autoTreatWingWatchConnections, wing.ChildAdded:Connect(WatchMedicalRoom))
	end
	WatchWing("Medical")
	WatchWing("Emergency")
end

local function StopAutoTreat()
	autoTreatGeneration = autoTreatGeneration + 1
	SetAutoTreatInstantPrompts(false)
	for _, connection in ipairs(autoTreatWingWatchConnections) do connection:Disconnect() end
	autoTreatWingWatchConnections = {}
end

AutoTreatToggle.MouseButton1Click:Connect(function()
	autoTreatEnabled = not autoTreatEnabled
	AutoTreatToggle.Text = autoTreatEnabled and "On" or "Off"
	if autoTreatEnabled then StartAutoTreat() else StopAutoTreat() end
end)

local AutoCoffeeRow, AutoCoffeeToggle = CreateFeatureRow(3, "Auto Coffee")

-- Auto Coffee ----------------------------------------------------------------------------
-- Confirmed structure: workspace.Misc.CoffeeMachine.Coffee is the pickup point (a
-- UnionOperation with its own "PP" prompt, ActionText "Coffee"). A BillboardGui on the
-- machine's Attachment has a "status" TextLabel that reads
-- "coffee: <font color='rgb(0, 200, 0)'>ready</font>" once it's done brewing (green
-- "ready", confirmed directly from the live text) -- watched here instead of the prompt's
-- own Enabled (which stays true the whole time regardless of brew state), so grabbing
-- happens the instant the text actually changes rather than polling on a guessed interval.
local autoCoffeeEnabled = false
local autoCoffeeConnection = nil
local autoCoffeePromptOriginal = nil

local function FindCoffeeMachineParts()
	local misc = workspace:FindFirstChild("Misc")
	local machine = misc and misc:FindFirstChild("CoffeeMachine")
	if not machine then return nil, nil, nil end
	local coffee = machine:FindFirstChild("Coffee")
	local prompt = coffee and coffee:FindFirstChild("PP")
	local attachment = machine:FindFirstChildOfClass("Attachment")
	local ui = attachment and attachment:FindFirstChild("UI")
	local statusLabel = ui and ui:FindFirstChild("status")
	return coffee, prompt, statusLabel
end

local function IsCoffeeReady(statusLabel)
	return statusLabel ~= nil and statusLabel.Text:lower():find("ready", 1, true) ~= nil
end

local function GrabCoffee(coffee, prompt)
	FirePromptNear(coffee:GetPivot().Position, prompt, nil, 1)
end

local function StartAutoCoffee()
	local coffee, prompt, statusLabel = FindCoffeeMachineParts()
	if not (coffee and prompt and statusLabel) then return end
	autoCoffeePromptOriginal = {HoldDuration = prompt.HoldDuration, RequiresLineOfSight = prompt.RequiresLineOfSight}
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false
	-- Grab right away if it's already sitting ready when this gets turned on, instead of
	-- waiting for the next brew cycle to notice it.
	if IsCoffeeReady(statusLabel) then GrabCoffee(coffee, prompt) end
	autoCoffeeConnection = statusLabel:GetPropertyChangedSignal("Text"):Connect(function()
		if not autoCoffeeEnabled then return end
		if IsCoffeeReady(statusLabel) then
			GrabCoffee(coffee, prompt)
		end
	end)
end

local function StopAutoCoffee()
	if autoCoffeeConnection then
		autoCoffeeConnection:Disconnect()
		autoCoffeeConnection = nil
	end
	if autoCoffeePromptOriginal then
		local _, prompt = FindCoffeeMachineParts()
		if prompt then
			prompt.HoldDuration = autoCoffeePromptOriginal.HoldDuration
			prompt.RequiresLineOfSight = autoCoffeePromptOriginal.RequiresLineOfSight
		end
		autoCoffeePromptOriginal = nil
	end
end

AutoCoffeeToggle.MouseButton1Click:Connect(function()
	autoCoffeeEnabled = not autoCoffeeEnabled
	AutoCoffeeToggle.Text = autoCoffeeEnabled and "On" or "Off"
	if autoCoffeeEnabled then StartAutoCoffee() else StopAutoCoffee() end
end)

-- Minimize: shrinks to just the header, matching Serenity's own minimize behavior. Every
-- row lives inside ContentScroll now, so hiding that one frame is enough.
local minimized = false
local function ToggleMinimize()
	minimized = not minimized
	HeaderDivider.Visible = not minimized
	ContentScroll.Visible = not minimized
	PanelFrame.Size = UDim2.new(0, 280, 0, minimized and MINI_HEIGHT or FULL_HEIGHT)
	-- Collapse the ESP Options section on minimize instead of leaving it expanded (and
	-- wasting space) once the panel gets restored.
	if minimized then
		ESPOptionsContainer.Visible = false
	end
end
MinimizeButton.MouseButton1Click:Connect(ToggleMinimize)

-- Plays the reverse of the open animation (pop + fade out) before actually destroying,
-- instead of just vanishing -- debounced so a double-click mid-fade can't fire this twice.
local closingPanel = false
CloseButton.MouseButton1Click:Connect(function()
	if closingPanel then return end
	closingPanel = true
	StopESP()
	StopAutoTreat()
	StopAutoCoffee()
	local fadeOutInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(PanelScale, fadeOutInfo, {Scale = 0.85}):Play()
	local fadeOutTween = TweenService:Create(PanelFrame, fadeOutInfo, {BackgroundTransparency = 1})
	fadeOutTween:Play()
	fadeOutTween.Completed:Wait()
	ScreenGui:Destroy()
end)

-- Dragging
local dragging = false
local dragStart = nil
local startPos = nil
PanelFrame.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	dragging = true
	dragStart = input.Position
	startPos = PanelFrame.Position
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			dragging = false
		end
	end)
end)
UserInputService.InputChanged:Connect(function(input)
	if not dragging or (input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch) then return end
	local delta = input.Position - dragStart
	PanelFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	getgenv().Serenity_AH_PanelPosition = PanelFrame.Position
end)

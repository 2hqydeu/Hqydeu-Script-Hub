local TaskRemote2 = ReplicatedStorage:WaitForChild("TaskRemote2")
-- Second listener alongside the game's own TaskLocal -- Roblox lets a RemoteEvent have any
-- number of OnClientEvent connections, so this doesn't interfere with (or need to touch)
-- what TaskLocal itself is already doing with the same event.
TaskRemote2.OnClientEvent:Connect(function(part)
	if part and part:IsA("BasePart") then
		taskState.CurrentPart = part
	else
		taskState.CurrentPart = nil
	end
end)

local function FireButton(button)
	if not button then return false end
	if type(firesignal) == "function" then
		local success = pcall(firesignal, button.MouseButton1Click)
		if success then return true end
	end
	-- Fallback for executors without firesignal -- a real click simulated at the button's
	-- own screen position. Less reliable (covered/offscreen buttons can miss) but better
	-- than nothing.
	if type(mousemoveabs) == "function" and type(mouse1click) == "function" then
		local pos = button.AbsolutePosition + button.AbsoluteSize / 2
		pcall(mousemoveabs, pos.X, pos.Y)
		pcall(mouse1click)
		return true
	end
	return false
end

-- Finds the LIVE Monitor clone specifically -- the one with Visible true -- rather than
-- whichever "Monitor" FindFirstChild happens to return first.
local function FindVisibleChild(parent, name)
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == name and child.Visible then
			return child
		end
	end
	return nil
end

-- Type 1: "Download" -- click the on-screen Button once, then TaskHandler's own script
-- runs the real 4-second progress fill and fires TaskRemote:FireServer itself.
local function HandleDownloadTask(monitor)
	local button = monitor.Screen:WaitForChild("Button", 2)
	if button and button.Active then
		FireButton(button)
	end
	-- Give the real 4s fill (plus its own finish delay) time to complete on its own.
	local start = os.clock()
	while os.clock() - start < 6 and monitor.Parent do
		task.wait(0.25)
	end
end

-- Type 3: "Code Pad" -- reads the same 4-digit code TaskHandler's script wrote onto the
-- in-world Paper prop, clicks each matching digit button, then Finish.
local function HandleCodeTask(codePad)
	local paper = codePad:FindFirstChild("Paper")
	local codeText = paper and paper:FindFirstChild("textik")
	local start = os.clock()
	while (not codeText or codeText.Text == "") and os.clock() - start < 2 do
		task.wait(0.1)
		paper = codePad:FindFirstChild("Paper")
		codeText = paper and paper:FindFirstChild("textik")
	end
	if not codeText or codeText.Text == "" then return end
	local code = codeText.Text
	for i = 1, #code do
		local digit = code:sub(i, i)
		local digitButton = codePad:FindFirstChild(digit)
		FireButton(digitButton)
		task.wait(0.12)
	end
	local finishButton = codePad:FindFirstChild("Finish")
	FireButton(finishButton)
	task.wait(0.3)
end

-- Type 2: "Press or Die" -- five rounds of a button that spawns at a random screen
-- position and shrinks back over 1.2s; must click each ButtonActive before it shrinks
-- back, missing even one aborts the whole minigame (TaskHandler's own logic, not this
-- script's), so this polls fast and clicks the instant one appears.
local function HandlePressTask(pressing)
	local clicked = {}
	local start = os.clock()
	while os.clock() - start < 12 and pressing.Parent do
		for _, child in ipairs(pressing:GetChildren()) do
			if child.Name == "ButtonActive" and not clicked[child] then
				clicked[child] = true
				FireButton(child)
			end
		end
		task.wait(0.03)
	end
end

local function RunTaskAtPart(part)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not prompt or not prompt.Enabled then return end
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	SetRootUpright(root, root.CFrame, part.Position - Vector3.new(0, 3, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	task.wait(taskState.TriggerDelay)
	if type(fireproximityprompt) ~= "function" then return end
	MakePromptInstant(prompt)
	pcall(fireproximityprompt, prompt)

	local playerGui = Player:FindFirstChildOfClass("PlayerGui")
	local tasksGui = playerGui and playerGui:WaitForChild("TasksGui", 2)
	if not tasksGui then return end

	-- Whichever of the three actually opens is the one this task turned out to be. Checked
	-- against a snapshot of Pressing's existing children so a stray leftover ButtonActive
	-- from a previous attempt can't be mistaken for a fresh one.
	local pressing = tasksGui:FindFirstChild("Pressing")
	local preExistingButtons = {}
	if pressing then
		for _, child in ipairs(pressing:GetChildren()) do
			if child.Name == "ButtonActive" then preExistingButtons[child] = true end
		end
	end

	local start = os.clock()
	while os.clock() - start < 2.5 do
		local monitor = FindVisibleChild(tasksGui, "Monitor")
		if monitor then
			HandleDownloadTask(monitor)
			return
		end
		if tasksGui.CodePad and tasksGui.CodePad.Visible then
			HandleCodeTask(tasksGui.CodePad)
			return
		end
		if pressing then
			for _, child in ipairs(pressing:GetChildren()) do
				if child.Name == "ButtonActive" and not preExistingButtons[child] then
					HandlePressTask(pressing)
					return
				end
			end
		end
		task.wait(0.05)
	end
end

TaskToggle.MouseButton1Click:Connect(function()
	taskState.Enabled = not taskState.Enabled
	TaskToggle.Text = taskState.Enabled and "On" or "Off"
end)

RunService.Heartbeat:Connect(function()
	if not ScreenGui.Parent then return end
	if not taskState.Enabled or taskState.Busy then return end
	if workspace:GetAttribute("Meeting") == true then return end
	local part = taskState.CurrentPart
	if not part or not part.Parent then return end
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end

	taskState.Busy = true
	task.spawn(function()
		pcall(RunTaskAtPart, part)
		-- Small settle delay before allowing the next attempt -- if the task genuinely
		-- didn't complete (detection missed something, or the server hasn't advanced
		-- CurrentPart yet), this stops it from re-triggering the exact same prompt on the
		-- very next Heartbeat and thrashing whatever GUI state is still mid-cleanup.
		task.wait(0.5)
		taskState.Busy = false
	end)
end)

-- ============================================================================
-- Auto Report: fully automatic now -- no manual button. Every live "Dead Body"
-- ProximityPrompt (matched by its exact ActionText/ObjectText, same pair confirmed on the
-- dump's own DeadPrompt template -- not a fixed path, since a real body spawns wherever
-- the kill happened) gets walked to and reported; when there's no body to report, the
-- Emergency button gets walked to and pressed instead. Both gated behind the ~30s
-- round-start window via Player:GetAttribute("InGame") actually flipping true (confirmed
-- real, not guessed -- see top of file). The emergency fallback has its own longer
-- cooldown (60s) so it doesn't just spam-call meetings back to back when no one's dead.
--
-- Live prompts are tracked via DescendantAdded/Removing instead of rescanning
-- workspace:GetDescendants() every frame -- that full-tree walk every single Heartbeat is
-- almost certainly what "extremely laggy" was. An initial one-time sweep catches anything
-- already in the world when this loads, then the two connections keep the small cached set
-- current from there with no further scanning at all.
-- ============================================================================
-- Fallback only -- kept in case a map's EmergencyModel.Timer (below) can't be read for
-- some reason, so reporting still eventually unlocks instead of staying gated forever.
local roundStartedAt = nil
local function MarkRoundStart()
	roundStartedAt = os.clock()
end
if Player:GetAttribute("InGame") == true then MarkRoundStart() end
Player:GetAttributeChangedSignal("InGame"):Connect(function()
	if Player:GetAttribute("InGame") == true then MarkRoundStart() end
end)
local REPORT_COOLDOWN_SECONDS = 30
local function FallbackReportGate()
	return roundStartedAt ~= nil and (os.clock() - roundStartedAt) >= REPORT_COOLDOWN_SECONDS
end

local function IsDeadBodyPrompt(descendant)
	return descendant:IsA("ProximityPrompt") and descendant.ActionText == "Report" and descendant.ObjectText == "Dead Body"
end

local deadBodyPrompts = {}
for _, descendant in ipairs(workspace:GetDescendants()) do
	if IsDeadBodyPrompt(descendant) then deadBodyPrompts[descendant] = true end
end
workspace.DescendantAdded:Connect(function(descendant)
	if IsDeadBodyPrompt(descendant) then deadBodyPrompts[descendant] = true end
end)
workspace.DescendantRemoving:Connect(function(descendant)
	deadBodyPrompts[descendant] = nil
end)

local function FindDeadBodyPrompt()
	for prompt in pairs(deadBodyPrompts) do
		if prompt.Parent and prompt.Enabled then return prompt end
		if not prompt.Parent then deadBodyPrompts[prompt] = nil end
	end
	return nil
end

-- Every map has its own EmergencyModel (e.g. workspace.Map.Airport.EmergencyModel) --
-- FindFirstChild(..., true) searches the whole tree recursively so this finds whichever
-- one actually exists in the currently loaded map without caring what map it is. Retried
-- (not resolved once) since the map might not have finished streaming in yet the moment
-- this script starts.
local emergencyModel, emergencyPrompt
local function ResolveEmergencyModel()
	if emergencyModel and emergencyModel.Parent then return end
	emergencyModel = workspace:FindFirstChild("EmergencyModel", true)
	if not emergencyModel then return end
	local button = emergencyModel:FindFirstChild("Button")
	emergencyPrompt = button and button:FindFirstChildOfClass("ProximityPrompt")
end
ResolveEmergencyModel()

-- The world Timer prop (EmergencyModel.Timer) is the real, authoritative "can you report
-- yet" signal -- confirmed to exist per-map, unlike the guessed 30s-since-InGame window
-- this used to lean on entirely. Its exact type isn't pinned down (could be a plain
-- NumberValue, or a Part whose SurfaceGui text just displays the countdown), so this reads
-- whichever it turns out to be: a numeric Value <= 0, or a descendant TextLabel whose text
-- reads as 0/empty/"ready". Falls back to the InGame-based guess only if no Timer-like
-- signal can be found at all.
local function FindReadableText(timer)
	if timer:IsA("TextLabel") or timer:IsA("TextButton") then return timer end
	return timer:FindFirstChildWhichIsA("TextLabel", true) or timer:FindFirstChildWhichIsA("TextButton", true)
end

local function IsReportReady()
	ResolveEmergencyModel()
	if not emergencyModel then return FallbackReportGate() end
	local timer = emergencyModel:FindFirstChild("Timer")
	if not timer then return FallbackReportGate() end

	if timer:IsA("ValueBase") then
		local value = timer.Value
		if type(value) == "number" then return value <= 0 end
	end

	local label = FindReadableText(timer)
	if label then
		local text = label.Text:lower()
		if text == "" or text == "0" or text:find("ready", 1, true) or text:find("go", 1, true) then
			return true
		end
		local numeric = tonumber(text:match("%d+"))
		if numeric then return numeric <= 0 end
	end

	return FallbackReportGate()
end

local function WalkAndTrigger(prompt)
	local anchor = prompt.Parent
	if not anchor then return end
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local position
	if anchor:IsA("BasePart") then
		position = anchor.Position
	elseif anchor:IsA("Model") or anchor:IsA("Attachment") then
		position = anchor:IsA("Attachment") and anchor.WorldPosition or anchor:GetPivot().Position
	end
	if not position then return end
	SetRootUpright(root, root.CFrame, position - Vector3.new(0, 2, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	-- One frame, not a real delay -- reporting/calling a meeting should be as close to
	-- instant as possible, this is only here so the teleport has actually replicated
	-- before the trigger fires.
	task.wait()
	if type(fireproximityprompt) == "function" then
		MakePromptInstant(prompt)
		pcall(fireproximityprompt, prompt)
	end
end

local reportState = {Enabled = false, LastReport = 0, LastMeetingCall = 0}
ReportToggle.MouseButton1Click:Connect(function()
	reportState.Enabled = not reportState.Enabled
	ReportToggle.Text = reportState.Enabled and "On" or "Off"
end)

RunService.Heartbeat:Connect(function()
	if not ScreenGui.Parent then return end
	if not reportState.Enabled or not IsReportReady() then return end
	if workspace:GetAttribute("Meeting") == true then return end

	local prompt = FindDeadBodyPrompt()
	if prompt then
		if os.clock() - reportState.LastReport < 3 then return end
		reportState.LastReport = os.clock()
		task.spawn(WalkAndTrigger, prompt)
		return
	end

	if emergencyPrompt and os.clock() - reportState.LastMeetingCall >= 60 then
		reportState.LastMeetingCall = os.clock()
		task.spawn(WalkAndTrigger, emergencyPrompt)
	end
end)


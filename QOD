-- Pill-shaped On/Off switch (oval track + round knob, track fills with a light color when
-- On) that replaces the old plain "On"/"Off" text button everywhere in this hub. Every
-- toggle call site already just does `toggle.Text = enabled and "On" or "Off"`, so this
-- hooks that same Text property instead of needing every call site rewritten: nothing
-- outside this function has to change to get the new visual.
local ToggleOffColor = Color3.fromRGB(24, 24, 24)
local ToggleOnColor = Color3.fromRGB(178, 155, 235)
local ToggleKnobColor = Color3.fromRGB(238, 233, 250)

-- Quick "pop" -- the actual toggle scales up a hair on hover and springs back down on
-- leave, never the row itself, so the row's label text never moves.

local function StyleAsToggleSwitch(toggle)
	toggle.AutoButtonColor = false
	toggle.TextTransparency = 1
	toggle.BackgroundColor3 = ToggleOffColor
	toggle.BackgroundTransparency = 0
	Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

	local knobSize = toggle.Size.Y.Offset - 6
	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.AnchorPoint = Vector2.new(0, 0.5)
	knob.Size = UDim2.new(0, knobSize, 0, knobSize)
	knob.Position = UDim2.new(0, 3, 0.5, 0)
	knob.BackgroundColor3 = ToggleKnobColor
	knob.BorderSizePixel = 0
	knob.ZIndex = toggle.ZIndex + 1
	knob.Parent = toggle
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
	-- The Edit popup bulk-bumps every descendant's ZIndex to one flat value (see
	-- BumpZIndex further down), which would otherwise flatten the knob to the same layer
	-- as its own track. Keep it one layer above whatever the track's ZIndex becomes
	-- instead of a fixed value.
	toggle:GetPropertyChangedSignal("ZIndex"):Connect(function() knob.ZIndex = toggle.ZIndex + 1 end)

	local function Refresh(animate)
		local on = toggle.Text == "On"
		local trackColor = on and ToggleOnColor or ToggleOffColor
		local knobPosition = on and UDim2.new(1, -3 - knobSize, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		if animate then
			local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(toggle, tweenInfo, {BackgroundColor3 = trackColor}):Play()
			TweenService:Create(knob, tweenInfo, {Position = knobPosition}):Play()
		else
			toggle.BackgroundColor3 = trackColor
			knob.Position = knobPosition
		end
	end

	toggle:GetPropertyChangedSignal("Text"):Connect(function() Refresh(true) end)
	Refresh(false)
end

-- Feature row layout: label left, toggle right. parent defaults to ContentScroll (the main
-- panel's row list); pass a different one (e.g. a popup's own row list) to place it there
-- instead. order sets LayoutOrder (rows stack in creation order if not given one).
local nextRowOrder = 1
local function CreateFeatureRow(order, labelText, parent)
	local row = Instance.new("Frame")
	row.Name = labelText:gsub("%s+", "") .. "Row"
	row.LayoutOrder = order or nextRowOrder
	nextRowOrder = math.max(nextRowOrder, row.LayoutOrder) + 1
	-- Narrowed from full width -- otherwise the row's own right edge (and its rounded
	-- corner) sits exactly where the scrollbar renders, getting visibly cut off by it.
	row.Size = UDim2.new(1, -10, 0, 48)
	row.BackgroundColor3 = Color3.fromRGB(9, 9, 9)
	row.BackgroundTransparency = GameRowTransparency
	row.BorderSizePixel = 0
	row.Parent = parent or ContentScroll
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(0, 140, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.Font = UIFont
	label.TextSize = 14
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = row

	local toggle = Instance.new("TextButton")
	toggle.Name = "Toggle"
	toggle.Size = UDim2.new(0, 46, 0, 24)
	toggle.Position = UDim2.new(1, -56, 0.5, -12)
	toggle.BorderSizePixel = 0
	toggle.Text = "Off"
	toggle.Font = UIFont
	toggle.TextSize = 14
	toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
	toggle.Parent = row
	StyleAsToggleSwitch(toggle)
	AddPressBounce(toggle)
	-- No hover stroke on the toggle itself -- the knob sits almost flush against the pill's
	-- rounded end, and a stroke curving tightly around that same corner was reading as a
	-- stray mark/"text" inside the switch.

	return row, toggle
end


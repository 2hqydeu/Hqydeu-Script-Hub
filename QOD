-- Small shared polish helpers -- hover brighten, a tactile press-down "squish", and a
-- divider that fades out at both ends instead of a flat bar. Same visual pass as the main
-- hub, ported here for a consistent feel across every panel.
local function AddButtonHover(button, hoverColor, normalColor)
	normalColor = normalColor or button.BackgroundColor3
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = hoverColor}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = normalColor}):Play()
	end)
end

-- AddPressBounce and AddHoverPop both animate a control's scale -- Roblox only honors one
-- UIScale per object, so if each created its own, they'd silently fight. This finds an
-- existing one on the target before making a new one, so both share the same instance.
local function GetOrCreateUIScale(target)
	local scale = target:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = target
	end
	return scale
end

local function AddPressBounce(button)
	local scale = GetOrCreateUIScale(button)
	-- Guarded by "pressed" -- this used to reset to Scale=1 on every single MouseLeave,
	-- which fought a row's hover-pop group: leaving just this control (while the cursor is
	-- still over the rest of the row) fired this button's own MouseLeave and snapped the
	-- shared scale back down, even though the row itself was never left. Now MouseLeave
	-- only resets if a press is actually in progress.
	local pressed = false
	local function release()
		if not pressed then return end
		pressed = false
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
	end
	button.MouseButton1Down:Connect(function()
		pressed = true
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.8}):Play()
	end)
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
end

local function AddFadeDivider(divider)
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = divider
end



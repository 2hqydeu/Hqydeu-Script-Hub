-- Was a fallback chain (keypress first, VirtualInputManager only if keypress errored) --
-- changed to fire BOTH unconditionally every time, same reasoning as FireButton firing both
-- Activated and MouseButton1Click elsewhere in this hub. The problem: pcall(keypress, ...)
-- not erroring only proves the CALL didn't crash, not that the game actually registered a
-- real press -- if this executor's keypress silently no-ops for whatever reason instead of
-- throwing, the old code would count that as "handled" and never even try
-- VirtualInputManager, which lines up exactly with "being pressed but not doing anything."
local function PressAbilityKey(keyCode)
	if type(keypress) == "function" then
		pcall(keypress, keyCode)
	end
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
	end)
end
local function ReleaseAbilityKey(keyCode)
	if type(keyrelease) == "function" then
		pcall(keyrelease, keyCode)
	end
	pcall(function()
		VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
	end)
end

-- The 0.02s hold from the speed-up round was very likely too brief for the game's own input
-- handling to register as a genuine press at all -- UE's own proven-working key-hold
-- (PressInteractKey/ReleaseInteractKey) uses 0.3s, 15x longer, which lines up with
-- "presses are happening but not doing anything." Bumped to 0.15s as a middle ground --
-- still far faster than manual play, but long enough to actually register.
local abilityKeys = {
	{keyCode = Enum.KeyCode.Q, toggle = QToggle},
	{keyCode = Enum.KeyCode.E, toggle = EToggle},
	{keyCode = Enum.KeyCode.R, toggle = RToggle},
}
local PRESS_HOLD = 0.15
local PRESS_GAP = 0.05

-- Second real bug, found after staggering (see git history) didn't fully fix the imbalance:
-- three INDEPENDENT loops each still attempt a cast every cycle regardless of what the other
-- two are doing. If this game gates ability casts behind a single shared cooldown/debounce
-- (one cast accepted at a time, no matter which key), a fixed stagger order means whichever
-- key's turn lands first in every cycle keeps re-winning that shared gate every single time --
-- Q before E before R, forever, since their relative order never changes. That matches
-- "E fires way more than R" being a consistent imbalance rather than random luck: E's press
-- always arrives before R's within the same 0.2s window, so R keeps finding the gate already
-- closed by E's cast a moment earlier.
--
-- Fixed by collapsing the three loops into one, which round-robins through whichever keys are
-- currently toggled on -- only one key is ever pressed per PRESS_GAP tick, and the rotation
-- pointer advances regardless of which keys are enabled, so every toggled-on key gets an equal,
-- alternating turn instead of always racing the same fixed order.
local nextAbilityIndex = 1
task.spawn(function()
	while true do
		task.wait(PRESS_GAP)
		if not ScreenGui.Parent then return end
		if abilitySpamState.Enabled then
			for _ = 1, #abilityKeys do
				local ability = abilityKeys[nextAbilityIndex]
				nextAbilityIndex = (nextAbilityIndex % #abilityKeys) + 1
				if ability.toggle.Text == "On" then
					PressAbilityKey(ability.keyCode)
					task.wait(PRESS_HOLD)
					ReleaseAbilityKey(ability.keyCode)
					break
				end
			end
		end
	end
end)

-- ============================================================================
-- Reduce Lag: confirmed from the dump that a single round had 210 individual zombie models
-- live simultaneously, each a full R6 rig (Head/Torso/Left Arm/Right Arm/Left Leg/Right Leg/
-- HumanoidRootPart, each with its own decals and ragdoll BallSocketConstraints) sitting in
-- workspace.Zombies_Local -- that volume of fully-rendered, fully-collidable rigs is almost
-- certainly the real lag source, and the "_Local" naming (also on the separate
-- FriendlyZombies_Local folder) strongly implies these are client-side-only cosmetic
-- copies -- the server broadcasts state and each client renders its own -- so stripping them
-- down visually should have zero effect on actual hit registration, purely a rendering/
-- physics-cost cut. Head is left alone (still visible, still collidable) so you can still
-- see where zombies actually are and land hits/aim; every other BasePart gets
-- Transparency = 1 and CanCollide = false (removing both the render cost AND the physics
-- cost of 200+ collidable rigs able to bump into you). Nothing is destroyed, so turning this
-- back off restores every part exactly as it was.
--
-- Edit adds one refinement, on by default whenever the master toggle is: Head ESP (a
-- Highlight on each remaining Head -- no distance/name labels, just an outline, since
-- that's genuinely all that was asked for).
--
-- A Bullet Tracer lessening option (culling ~half of new workspace.Bullets_Local children
-- on the same "_Local = client-only cosmetic" assumption as the zombie folders) was tried
-- and removed -- turned out wrong in practice: destroying those instances measurably cut
-- down actual gun fire/hit output, meaning Bullets_Local isn't purely cosmetic the way the
-- zombie folders are (very likely tied to client-side hit-registration/travel logic, not
-- just visuals). Not reworked blindly since what actually broke isn't confirmed -- would
-- need to inspect a live bullet instance's real structure first.
-- ============================================================================
local ZOMBIE_CONTAINER_NAMES = {"Zombies_Local", "FriendlyZombies_Local"}
local reduceLagState = {Enabled = false, HeadESP = true}
local strippedParts = {}
local headHighlights = {}

local function StripZombiePart(part)
	if strippedParts[part] then return end
	strippedParts[part] = {Transparency = part.Transparency, CanCollide = part.CanCollide}
	part.Transparency = 1
	part.CanCollide = false
end

local function RestoreZombiePart(part)
	local original = strippedParts[part]
	if not original then return end
	strippedParts[part] = nil
	if not part.Parent then return end
	pcall(function()
		part.Transparency = original.Transparency
		part.CanCollide = original.CanCollide
	end)
end

local HOSTILE_ESP_COLOR = Color3.fromRGB(255, 70, 70)
local FRIENDLY_ESP_COLOR = Color3.fromRGB(80, 255, 120)

-- Confirmed from the new save instance: FriendlyZombies_Local models use the exact same
-- rig structure as hostile ones (just an extra particle/glow on Head), so the only thing
-- that actually needs to change is which color gets used -- determined by which container
-- the model's Parent currently is, not by anything on the model itself.
local function GetESPColorForModel(model)
	if model.Parent and model.Parent.Name == "FriendlyZombies_Local" then
		return FRIENDLY_ESP_COLOR

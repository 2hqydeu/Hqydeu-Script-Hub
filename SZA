-- Same fallback chain as UE/Animal_Hospital's own key-simulation helpers: a real
-- keypress/keyrelease exploit function first, VirtualInputManager as the fallback.
local function PressAbilityKey(keyCode)
	if type(keypress) == "function" then
		local ok = pcall(keypress, keyCode)
		if ok then return true end
	end
	return pcall(function()
		VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
	end)
end
local function ReleaseAbilityKey(keyCode)
	if type(keyrelease) == "function" then
		local ok = pcall(keyrelease, keyCode)
		if ok then return end
	end
	pcall(function()
		VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
	end)
end

-- One independent loop per ability so all three can spam concurrently rather than taking
-- turns -- costs (gems/souls, whichever this class's abilities actually use) and cooldowns
-- are left entirely to the server to enforce, same as a person mashing the key would hit.
local abilityKeys = {
	{keyCode = Enum.KeyCode.Q, toggle = QToggle},
	{keyCode = Enum.KeyCode.E, toggle = EToggle},
	{keyCode = Enum.KeyCode.R, toggle = RToggle},
}
-- Sped up from the original 0.1s wait + 0.05s hold (~6.6 presses/sec) to a 0.02s hold +
-- 0.02s gap (~25/sec) -- the key-simulation itself is essentially free client-side (it's
-- not rendering or physics work, just synthetic input events), so this shouldn't add any
-- real client-side lag. The only real tradeoff is more RemoteEvent traffic hitting the
-- server if the ability system fires one per press attempt, which is a server/network
-- concern rather than a client lag one -- if it turns out to cause rubber-banding or
-- similar, dial PRESS_HOLD/PRESS_GAP back down.
local PRESS_HOLD = 0.02
local PRESS_GAP = 0.02
for _, ability in ipairs(abilityKeys) do
	task.spawn(function()
		while true do
			task.wait(PRESS_GAP)
			if not ScreenGui.Parent then return end
			if abilitySpamState.Enabled and ability.toggle.Text == "On" then
				PressAbilityKey(ability.keyCode)
				task.wait(PRESS_HOLD)
				ReleaseAbilityKey(ability.keyCode)
			end
		end
	end)
end

-- ============================================================================
-- Reduce Lag: confirmed from the dump that a single round had 210 individual zombie models
-- live simultaneously, each a full R6 rig (Head/Torso/Left Arm/Right Arm/Left Leg/Right Leg/
-- HumanoidRootPart, each with its own decals and ragdoll BallSocketConstraints) sitting in
-- workspace.Zombies_Local -- that volume of fully-rendered, fully-collidable rigs is almost
-- certainly the real lag source, and the "_Local" naming (also on the separate
-- FriendlyZombies_Local folder) strongly implies these are client-side-only cosmetic
-- copies -- the server broadcasts state and each client renders its own -- so stripping them
-- down visually should have zero effect on actual hit registration, purely a rendering/
-- physics-cost cut. Head is left alone (still visible, still collidable) so you can still
-- see where zombies actually are and land hits/aim; every other BasePart gets
-- Transparency = 1 and CanCollide = false (removing both the render cost AND the physics
-- cost of 200+ collidable rigs able to bump into you). Nothing is destroyed, so turning this
-- back off restores every part exactly as it was.
--
-- Edit adds one refinement, on by default whenever the master toggle is: Head ESP (a
-- Highlight on each remaining Head -- no distance/name labels, just an outline, since
-- that's genuinely all that was asked for).
--
-- A Bullet Tracer lessening option (culling ~half of new workspace.Bullets_Local children
-- on the same "_Local = client-only cosmetic" assumption as the zombie folders) was tried
-- and removed -- turned out wrong in practice: destroying those instances measurably cut
-- down actual gun fire/hit output, meaning Bullets_Local isn't purely cosmetic the way the
-- zombie folders are (very likely tied to client-side hit-registration/travel logic, not
-- just visuals). Not reworked blindly since what actually broke isn't confirmed -- would
-- need to inspect a live bullet instance's real structure first.
-- ============================================================================
local ZOMBIE_CONTAINER_NAMES = {"Zombies_Local", "FriendlyZombies_Local"}
local reduceLagState = {Enabled = false, HeadESP = true}
local strippedParts = {}
local headHighlights = {}

local function StripZombiePart(part)
	if strippedParts[part] then return end
	strippedParts[part] = {Transparency = part.Transparency, CanCollide = part.CanCollide}
	part.Transparency = 1
	part.CanCollide = false
end

local function RestoreZombiePart(part)
	local original = strippedParts[part]
	if not original then return end
	strippedParts[part] = nil
	if not part.Parent then return end
	pcall(function()
		part.Transparency = original.Transparency
		part.CanCollide = original.CanCollide
	end)
end

local function SetHeadESP(head, on)
	if on then
		if headHighlights[head] or not head.Parent then return end
		local highlight = Instance.new("Highlight")
		highlight.Name = "SZA_HeadESP"
		highlight.FillColor = Color3.fromRGB(255, 70, 70)
		highlight.FillTransparency = 0.5
		highlight.OutlineColor = Color3.fromRGB(255, 70, 70)
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = head
		highlight.Parent = head
		headHighlights[head] = highlight
	else
		local highlight = headHighlights[head]
		if highlight then
			highlight:Destroy()
			headHighlights[head] = nil
		end
	end
end

local function ApplyReduceLagToModel(model)
	local head = model:FindFirstChild("Head")
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") and part ~= head then
			StripZombiePart(part)
		end
	end
	if head then SetHeadESP(head, reduceLagState.HeadESP) end
end

local function RestoreModel(model)
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") then
			RestoreZombiePart(part)
		end
	end
	local head = model:FindFirstChild("Head")
	if head then SetHeadESP(head, false) end
end

local function ForEachTrackedZombieModel(callback)
	for _, name in ipairs(ZOMBIE_CONTAINER_NAMES) do
		local container = workspace:FindFirstChild(name)
		if container then

-- ============================================================================
-- HUD: zombie count (Zombies_Local only, same reasoning as above) and a gems/second
-- rate. Confirmed real path for the currency readout: PlayerGui.MainGui.MineralsDisplay's
-- own TextLabel (showed "100" in the dump) -- ParseCount below handles comma-separated
-- ("207,207") and K/M/B-suffixed values generically, in case the real number ever gets
-- large enough to display that way. Rate is a running average since the HUD was last
-- turned on (baseline value + baseline timestamp, not a sliding window), reset every time
-- it's toggled on.
-- ============================================================================
local function ParseCount(text)
	if not text then return nil end
	text = text:gsub(",", ""):gsub("%s", "")
	if text == "" then return nil end
	local suffix = text:sub(-1):upper()
	local multiplier = 1
	if suffix == "K" then
		multiplier = 1000
		text = text:sub(1, -2)
	elseif suffix == "M" then
		multiplier = 1000000
		text = text:sub(1, -2)
	elseif suffix == "B" then
		multiplier = 1000000000
		text = text:sub(1, -2)
	end
	local number = tonumber(text)
	if not number then return nil end
	return number * multiplier
end

local mineralsLabel
local function ResolveMineralsLabel()
	if mineralsLabel and mineralsLabel.Parent then return end
	local playerGui = Player:FindFirstChildOfClass("PlayerGui")

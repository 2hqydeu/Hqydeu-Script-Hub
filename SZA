local autoAimTarget = nil

local function UpdateAutoShootPressState()
	if autoShootState.Enabled and not autoShootState.Pressed then
		if PressMouse1() then autoShootState.Pressed = true end
	elseif not autoShootState.Enabled and autoShootState.Pressed then
		ReleaseMouse1()
		autoShootState.Pressed = false
	end
end


-- ============================================================================
-- Farm, rebuilt after the first version's real problems:
--
-- 1. It wasn't actually flight, just a one-time teleport-up plus zeroing vertical velocity
--    -- nothing ever countered horizontal drift, so any residual momentum just accumulated
--    unopposed (the reported "drifts off in every which way"), and zeroing velocity alone
--    is weaker than an actual anchor -- over time it lost the fight against gravity/physics
--    (the reported "fell down after a while"). Replaced with the exact same BodyVelocity +
--    BodyGyro "zero-G anchor" technique Main's own proven Fly feature already uses
--    (MaxForce = math.huge zeroes out gravity AND drift, not just vertical velocity), plus
--    real WASD-relative-to-camera + Space/Shift movement -- an actual fly, not a fixed
--    hover, so you can freely reposition over the crowd.
-- 2. Forcing the camera to a hard first-person-style straight-down lock AND recentering the
--    mouse cursor every single render frame is what made it impossible to even click the
--    toggle back off (the cursor was being yanked back to center faster than a click could
--    land) -- neither is done anymore. Farm no longer touches the camera or mouse position
--    at all after the initial engage, so third-person control stays entirely yours. A dedicated
--    F keybind is also added as a hard off-switch regardless of UI state, just in case.
-- 3. You noticed the game itself has its own proximity-based aim-assist/lock-on once
--    airborne with the crosshair roughly near a target -- so precise aiming was never
--    actually necessary. Firing is now a repeated press+release click loop (like Ability
--    Spam) instead of a single sustained hold, since you weren't sure hold-to-fire was
--    reliable for these tools ("if needed just click regularly") -- repeated clicks satisfy
--    both a click-based and a hold-based weapon script.
--
-- Neither LavaBow nor Interstellar (confirmed real Tools under ReplicatedStorage.Assets.
-- Guns) has a firing script living inside the Tool itself, so this equips whatever Tool is
-- already in Backpack rather than hardcoding either by name.
-- ============================================================================
local function PressWeaponButton()
	if type(mouse1press) == "function" then
		local ok = pcall(mouse1press)
		if ok then return true end
	end
	local loc = UserInputService:GetMouseLocation()
	return pcall(function()
		VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, true, game, 1)
	end)
end
local function ReleaseWeaponButton()
	if type(mouse1release) == "function" then
		local ok = pcall(mouse1release)
		if ok then return end
	end
	local loc = UserInputService:GetMouseLocation()
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, false, game, 1)
	end)
end

local function EquipAnyWeapon()
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or not character then return end
	if character:FindFirstChildOfClass("Tool") then return end
	local backpack = Player:FindFirstChildOfClass("Backpack")
	local tool = backpack and backpack:FindFirstChildOfClass("Tool")
	if tool then humanoid:EquipTool(tool) end
end

local FARM_FLY_SPEED = 10
-- Was 60 -- you mentioned the game's own aim-assist/lock-on needs you within some distance
-- of a target to actually engage, so floating that high was very likely outside its range
-- entirely. Dropped to a height that's still comfortably above head-height on the ground
-- (out of easy melee reach) but far closer to the crowd -- a guess at the right number
-- since the lock-on's actual max range isn't confirmed, so treat this as a starting point
-- to tune from based on how it feels in practice.
local FARM_HEIGHT = 25

local farmState = {Enabled = false, BodyVelocity = nil, BodyGyro = nil, NoclipOriginal = {}}

local function EngageFarm()
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root then return end
	EquipAnyWeapon()

	farmState.BodyVelocity = Instance.new("BodyVelocity")
	farmState.BodyVelocity.Velocity = Vector3.zero
	farmState.BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	farmState.BodyVelocity.Parent = root

	farmState.BodyGyro = Instance.new("BodyGyro")
	farmState.BodyGyro.P = 9e4
	farmState.BodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	farmState.BodyGyro.CFrame = root.CFrame
	farmState.BodyGyro.Parent = root

	root.CFrame = root.CFrame + Vector3.new(0, FARM_HEIGHT, 0)

	-- One-time courtesy tilt so you start out already looking roughly toward the ground --
	-- not the hard -90 first-person-style lock from before, and never reasserted after this.
	local camera = workspace.CurrentCamera
	if camera then
		camera.CFrame = CFrame.new(camera.CFrame.Position) * CFrame.Angles(-math.rad(55), 0, 0)
	end
end

local function DisengageFarm()
	if farmState.BodyVelocity then farmState.BodyVelocity:Destroy() farmState.BodyVelocity = nil end
	if farmState.BodyGyro then farmState.BodyGyro:Destroy() farmState.BodyGyro = nil end
	for part, wasCollidable in pairs(farmState.NoclipOriginal) do
		if part and part.Parent then part.CanCollide = wasCollidable end
	end
	table.clear(farmState.NoclipOriginal)
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end


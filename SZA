-- ============================================================================
-- Farm, rebuilt again -- still drifting even with the BodyVelocity/BodyGyro anchor from the
-- last round. That combo only ever fights VELOCITY (holds it at zero once per frame), which
-- can suppress acceleration but never corrects position that already drifted between one
-- frame's correction and the next -- over enough frames those tiny uncorrected nudges add
-- up to visible drift, which matches exactly what kept happening. Velocity-only correction
-- was never going to fully solve it.
--
-- Switched to what you actually suggested: no more manual WASD/Space/Shift flight at all
-- (removed per your request for a fixed height instead of free-fly), just noclip + a light
-- Heartbeat anti-fall to survive the gaps, PLUS a hard position snap -- teleported straight
-- to (nearest hostile zombie's X/Z, that same zombie's ground Y + FARM_HEIGHT) immediately
-- on engage and again every FARM_REPOSITION_INTERVAL seconds after that. A position snap
-- can't accumulate drift the way a velocity correction can -- it just overwrites wherever
-- you ended up with the correct spot outright, and re-centers over the crowd as it moves
-- between waves as a bonus. Height also stays relative to the zombies' own ground position
-- (not a fixed world Y), so it keeps making sense across different maps/terrain.
--
-- UPDATE: this hover-directly-above-target snap is now only used while a boss is up. The
-- default, no-boss behavior is a fixed-post sweep at Tundra-specific coordinates instead (see
-- GetFarmSweepPosition further down) -- per your own testing, spraying the whole area from one
-- good spot beats continuously chasing individual clusters around.
--
-- The auto lock-on discovery still applies -- firing is a repeated press+release click loop
-- (see PressWeaponButton/ReleaseWeaponButton below), and neither LavaBow nor Interstellar
-- (confirmed real Tools under ReplicatedStorage.Assets.Guns) has a firing script inside the
-- Tool itself, so this fires by clicking rather than calling either by name directly --
-- EquipBestWeapon below is what actually chooses which of them gets equipped.
--
-- (A hold-down version was tried -- fires faster/gap-free since the game's own per-frame
-- loop repeats TryFire() the whole time IsFiring is true, gated only by the weapon's real
-- FireRate -- but a real held-down synthetic click either got silently cancelled by any
-- genuine manual click, or, once re-asserted every tick to correct that, broke real clicks on
-- the panel itself. Back to plain repeated clicking, which doesn't have either problem: your
-- mouse works normally, and this can't get stuck since every cycle presses then releases.)
-- ============================================================================
local function PressWeaponButton()
	if type(mouse1press) == "function" then
		local ok = pcall(mouse1press)
		if ok then return true end
	end
	local loc = UserInputService:GetMouseLocation()
	return pcall(function()
		VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, true, game, 1)
	end)
end
local function ReleaseWeaponButton()
	if type(mouse1release) == "function" then
		local ok = pcall(mouse1release)
		if ok then return end
	end
	local loc = UserInputService:GetMouseLocation()
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, false, game, 1)
	end)
end

-- Confirmed from GunConfig in the place dump: Interstellar (0.168s fire rate, pierces 4
-- targets, its own small impact burst) and LavaBow (2160 direct / 3600 explosion damage in a
-- 21-stud radius) are both real and dramatically stronger than a generic weapon -- which gun
-- ends up equipped matters far more to kill speed than anything about movement or aim.
-- Actively prefers them, in this order, over "whatever's first in Backpack"; falls back to
-- that only if neither is owned.
local PREFERRED_WEAPON_NAMES = {"Interstellar", "LavaBow"}

local function EquipBestWeapon()
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or not character then return end
	local backpack = Player:FindFirstChildOfClass("Backpack")

	local equipped = character:FindFirstChildOfClass("Tool")
	if equipped and table.find(PREFERRED_WEAPON_NAMES, equipped.Name) then return end

	for _, name in ipairs(PREFERRED_WEAPON_NAMES) do
		local preferred = backpack and backpack:FindFirstChild(name)
		if preferred and preferred:IsA("Tool") then
			humanoid:EquipTool(preferred)
			return
		end
	end

	if equipped then return end
	local tool = backpack and backpack:FindFirstChildOfClass("Tool")
	if tool then humanoid:EquipTool(tool) end
end

-- Was 60, then 25 while Fly was still involved -- you mentioned the game's own aim-assist/
-- lock-on needs you within some distance of a target to actually engage. Kept at 25 as the
-- height OFFSET above wherever the nearest zombie's own ground position currently is (not a
-- fixed world Y), so it stays sensible across maps/terrain and re-centers as the crowd moves.
local FARM_HEIGHT = 25
-- Zombies within this of the nearest one count as the same "cluster" for both the reposition
-- snap and the continuous aim target (see GetFarmClusterTarget/StartFarmAim below).
local FARM_CLUSTER_RADIUS = 45
-- Was 5 -- now that Farm actually aims instead of firing blind (see StartFarmAim), a stale
-- hover position means aiming at where the crowd USED to be, not where it is. Shortened so it
-- re-centers close enough to real time as the group moves or thins out from kills.
local FARM_REPOSITION_INTERVAL = 2

-- Enabled is the toggle's user-facing intent (on the instant you click it, before the
-- countdown even starts); Engaged is whether the real effects -- noclip, anti-fall,
-- repositioning, and the fire loop -- are actually allowed to run. They used to be the same
-- flag, which meant the fire loop (and noclip) started immediately on toggle instead of
-- waiting out the 3-second countdown like the countdown itself implies they should.
local farmState = {Enabled = false, Engaged = false, AntiFallConnection = nil, NoclipOriginal = {}, HoldFireForAlly = false}

-- Nearest hostile zombie's position and, if others are within FARM_CLUSTER_RADIUS of it, the
-- centroid of that whole group instead of just the one nearest straggler -- both the
-- reposition snap (X/Z, +FARM_HEIGHT for Y) and the continuous aim target (StartFarmAim)
-- use this, so the AoE splash lands in the middle of the group it can actually reach instead
-- of wherever the single closest zombie happens to be standing. Falls back to nil (caller
-- decides what to do) if no zombies are currently tracked, e.g. between waves.
--
-- Exception: while a Yeti/Ultra Yeti is present, this fully locks onto it instead -- ignoring
-- every regular zombie entirely rather than averaging it into a crowd centroid -- since the
-- boss is the one that actually takes forever to kill and everything else nearby is
-- comparatively trivial by comparison.
local function GetFarmClusterTarget()
	local bossModel = FindBossModel()
	if bossModel then
		local bossRoot = bossModel:FindFirstChild("HumanoidRootPart")
		if bossRoot then return bossRoot.Position end
	end

	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local originPosition = root and root.Position

	local positions = {}
	ForEachHostileZombieModel(function(model)
		local zombieRoot = model:FindFirstChild("HumanoidRootPart")
		if zombieRoot then table.insert(positions, zombieRoot.Position) end
	end)
	if #positions == 0 then return nil end

	local nearestPosition = positions[1]
	if originPosition then
		local nearestDistance = (positions[1] - originPosition).Magnitude
		for _, position in ipairs(positions) do
			local distance = (position - originPosition).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestPosition = position
			end
		end
	end

	local sumPosition, count = Vector3.zero, 0
	for _, position in ipairs(positions) do
		if (position - nearestPosition).Magnitude <= FARM_CLUSTER_RADIUS then
			sumPosition = sumPosition + position
			count = count + 1
		end
	end
	return sumPosition / count
end

-- The actual anti-drift fix -- a hard position snap can't accumulate error the way
-- continuously correcting velocity can, since it just overwrites wherever you ended up with
-- the right spot outright instead of trying to gradually steer back to it.
local function RepositionFarmOverMobs()
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local targetGround = GetFarmClusterTarget()
	if not targetGround then return end
	local _, yaw = root.CFrame:ToOrientation()
	root.CFrame = CFrame.new(targetGround.X, targetGround.Y + FARM_HEIGHT, targetGround.Z) * CFrame.Angles(0, yaw, 0)
end

-- Tundra-only fixed post: floating spot to sweep back and forth from while spraying
-- whatever's below/around, instead of continuously chasing individual clusters -- these
-- coordinates are from your own testing, not derived from anything in the place dump, and
-- only make sense on this one map. A different map would need different coordinates (or just
-- the RepositionFarmOverMobs chase above) to make any sense at all. Y lowered from 29 -- say
-- if it needs to go further.
local FARM_SWEEP_BASE_POSITION = Vector3.new(-122, 19, 64)
-- Asymmetric per feedback -- the strafe axis's positive direction (+X, see strafeAxis below)
-- is your right, so this reaches quite a bit further that way than to the left.
local FARM_SWEEP_LEFT_WIDTH = 25
local FARM_SWEEP_RIGHT_WIDTH = 50
local FARM_SWEEP_PERIOD = 6

-- Fixed, not recomputed from wherever the crowd happens to be -- turns out regular zombies
-- don't need aim-locking at all (splash/pierce plus sweeping the width covers them from a
-- level shot), and constantly re-orienting toward a shifting centroid was exactly what read
-- as swaying. A constant direction means only position changes now, nothing rotates. Flip
-- the sign if this turns out to be facing away from the map instead of toward it.
local FARM_SWEEP_FACING_DIRECTION = Vector3.new(0, 0, -1)

-- Reset at the start of every EngageFarm so the sweep always starts from the same phase
-- (dead center) instead of continuing wherever a previous run happened to leave off.
local farmSweepStartClock = nil

-- Smooth, framerate-independent back-and-forth motion -- a sine wave eases naturally at each
-- end instead of snapping direction instantly, which is smoother than either teleporting
-- between two points or trying to simulate literal A/D key holds (which would also fight the
-- anti-fall Heartbeat below, since that unconditionally zeroes velocity every frame). The
-- strafe axis is perpendicular to the now-fixed facing direction, which for (0, 0, -1) works
-- out to pure world-X -- exactly the single axis asked for. Split into left/right widths
-- (picking whichever applies by the sine's current sign) instead of one symmetric width, so
-- the reach can differ per side while the motion through center stays smooth and continuous.
local function GetFarmSweepPosition()
	if not farmSweepStartClock then farmSweepStartClock = os.clock() end
	local elapsed = os.clock() - farmSweepStartClock
	local sineValue = math.sin(elapsed / FARM_SWEEP_PERIOD * (2 * math.pi))
	local sweepOffset = sineValue >= 0 and sineValue * FARM_SWEEP_RIGHT_WIDTH or sineValue * FARM_SWEEP_LEFT_WIDTH
	local strafeAxis = Vector3.new(-FARM_SWEEP_FACING_DIRECTION.Z, 0, FARM_SWEEP_FACING_DIRECTION.X)
	return FARM_SWEEP_BASE_POSITION + strafeAxis * sweepOffset
end

-- Confirmed from the place dump's real GunClient.GetAutoAimTarget: on PC it only computes a
-- genuinely aimed shot if it finds a zombie within ~120 screen-pixels of wherever
-- LocalPlayer:GetMouse() actually is, and only if that zombie is roughly in front of the
-- camera -- otherwise GetAimDirection falls back to the character's flat horizontal
-- LookVector with the vertical component forced to 0, no matter how the camera is tilted.
-- Farm used to tilt the camera once at engage and never touch the mouse again, so almost
-- every shot fired while hovering above a crowd flew out dead level, clean over their heads
-- -- that's the real reason Farm "worked" but felt slow. Fixed by taking the camera over
-- (Scriptable) and continuously pointing both it and the real mouse cursor at the crowd's
-- centroid every frame, so the game's own auto-aim has something to actually lock onto.
--
-- Camera sits pulled back and raised from the character (along the horizontal direction
-- toward the aim target) rather than exactly at the character's own position, which read as
-- forced first-person -- distance/height here are just handles to taste, nothing in the dump
-- to confirm them against since there's no real "camera" data to check.
local FARM_CAMERA_BACK_DISTANCE = 20
local FARM_CAMERA_HEIGHT_OFFSET = 12
-- Only applied to the fixed-facing sweep camera below, not the boss lock-on camera further
-- down -- that one already looks directly at the boss's real position, and biasing it
-- upward would just throw off precision on the one target that actually needs it. Look-at
-- point is well out in front (not just 1 stud) so this offset comes out as a gentle pitch
-- rather than an almost-straight-up stare.
local FARM_CAMERA_LOOKAHEAD_DISTANCE = 40
local FARM_CAMERA_UP_TILT = 12
-- A bit more generous than the game's own ~120px lock-on radius, so the crosshair steers
-- clear of an ally with some margin instead of right up against the exact threshold.
local FARM_ALLY_SAFE_PIXELS = 130

local farmAimConnection

local function StartFarmAim()
	local camera = workspace.CurrentCamera
	if not camera then return end
	camera.CameraType = Enum.CameraType.Scriptable
	farmAimConnection = RunService.RenderStepped:Connect(function()
		if not farmState.Engaged then return end
		local currentCamera = workspace.CurrentCamera
		local character = Player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not currentCamera or not root then return end

		-- No more aim-locking onto regular zombies -- turns out sweeping a fixed width while
		-- facing forward and holding the trigger already connects with the whole area (splash
		-- damage/piercing doing the rest), and continuously re-aiming toward a shifting
		-- centroid was exactly what read as swaying. So with no boss up: sweep position AND
		-- camera both just track the fixed facing direction, nothing rotates, and the mouse
		-- cursor is left alone entirely (no target to point it at). HoldFireForAlly is reset
		-- since there's no crosshair here to check an ally's distance against -- ally-safety
		-- only really applies once we're actually aiming at something, i.e. the boss below.
		local bossModel = FindBossModel()
		if not bossModel then
			local sweepPosition = GetFarmSweepPosition()
			root.CFrame = CFrame.lookAt(sweepPosition, sweepPosition + FARM_SWEEP_FACING_DIRECTION)
			local cameraPosition = sweepPosition - FARM_SWEEP_FACING_DIRECTION * FARM_CAMERA_BACK_DISTANCE + Vector3.new(0, FARM_CAMERA_HEIGHT_OFFSET, 0)
			local cameraLookAt = sweepPosition + FARM_SWEEP_FACING_DIRECTION * FARM_CAMERA_LOOKAHEAD_DISTANCE + Vector3.new(0, FARM_CAMERA_UP_TILT, 0)
			currentCamera.CFrame = CFrame.lookAt(cameraPosition, cameraLookAt)
			farmState.HoldFireForAlly = false
			return
		end

		-- Yeti/Ultra Yeti present -- full lock-on, unchanged from before.
		local aimTarget = GetFarmClusterTarget()
		if not aimTarget then return end

		local horizontalDirection = Vector3.new(aimTarget.X - root.Position.X, 0, aimTarget.Z - root.Position.Z)
		horizontalDirection = horizontalDirection.Magnitude > 0.01 and horizontalDirection.Unit or Vector3.new(0, 0, -1)
		local cameraPosition = root.Position - horizontalDirection * FARM_CAMERA_BACK_DISTANCE + Vector3.new(0, FARM_CAMERA_HEIGHT_OFFSET, 0)
		currentCamera.CFrame = CFrame.lookAt(cameraPosition, aimTarget)

		local screenPoint, onScreen = currentCamera:WorldToScreenPoint(aimTarget)
		if not onScreen then return end

		-- FriendlyZombies_Local models use the identical rig to hostiles (confirmed in Reduce
		-- Lag's own notes), so the game's aim-lock has no way to tell them apart from a
		-- hostile on its own -- withhold firing (see the fire loop below) the moment an ally
		-- drifts within the same on-screen area the crosshair is aiming at, and resume once
		-- it's clear, rather than risk landing an explosive arrow on one.
		local allyTooClose = false
		ForEachFriendlyZombieModel(function(model)
			if allyTooClose then return end
			local friendlyRoot = model:FindFirstChild("HumanoidRootPart")
			if not friendlyRoot then return end
			local friendlyScreenPoint, friendlyOnScreen = currentCamera:WorldToScreenPoint(friendlyRoot.Position)
			if not friendlyOnScreen then return end
			local dx, dy = friendlyScreenPoint.X - screenPoint.X, friendlyScreenPoint.Y - screenPoint.Y
			if math.sqrt(dx * dx + dy * dy) <= FARM_ALLY_SAFE_PIXELS then
				allyTooClose = true
			end
		end)
		farmState.HoldFireForAlly = allyTooClose

		if type(mousemoveabs) == "function" then
			pcall(mousemoveabs, screenPoint.X, screenPoint.Y)
		end
	end)
end

local function StopFarmAim()
	if farmAimConnection then
		farmAimConnection:Disconnect()
		farmAimConnection = nil
	end
	farmState.HoldFireForAlly = false
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
	end
end

local function EngageFarm()
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root then return end
	farmState.Engaged = true
	EquipBestWeapon()

	-- Fresh sweep phase every engage, so it always starts dead center instead of wherever a
	-- previous run's clock happened to leave off.
	farmSweepStartClock = os.clock()
	if FindBossModel() then
		RepositionFarmOverMobs()
	else
		local sweepPosition = GetFarmSweepPosition()
		root.CFrame = CFrame.lookAt(sweepPosition, sweepPosition + FARM_SWEEP_FACING_DIRECTION)
	end

	farmState.AntiFallConnection = RunService.Heartbeat:Connect(function()
		local currentCharacter = Player.Character
		local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
		if currentRoot then
			currentRoot.AssemblyLinearVelocity = Vector3.zero
			currentRoot.AssemblyAngularVelocity = Vector3.zero
		end
	end)

	-- Only repositions (hovers directly above whatever GetFarmClusterTarget returns) while a
	-- boss is up -- StartFarmAim's own per-frame check drives the sweep the rest of the time,
	-- and letting both fight over root.CFrame would mean popping back to hovering over the
	-- crowd every FARM_REPOSITION_INTERVAL seconds instead of a clean continuous sweep.
	task.spawn(function()
		while farmState.Engaged do
			task.wait(FARM_REPOSITION_INTERVAL)
			if not farmState.Engaged then return end
			if FindBossModel() then
				RepositionFarmOverMobs()
			end
		end
	end)

	StartFarmAim()
end

local function DisengageFarm()
	farmState.Engaged = false
	StopFarmAim()
	if farmState.AntiFallConnection then
		farmState.AntiFallConnection:Disconnect()
		farmState.AntiFallConnection = nil
	end
	for part, wasCollidable in pairs(farmState.NoclipOriginal) do

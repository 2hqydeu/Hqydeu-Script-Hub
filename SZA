-- Real fly movement -- ported directly from Main's own Fly feature (BodyGyro kept at the
-- camera's yaw, WASD/Space/Shift nudge the root CFrame relative to camera directions, zero
-- velocity re-applied every frame so nothing accumulates).
RunService:BindToRenderStep("SZA_Farm", Enum.RenderPriority.Camera.Value + 1, function()
	if not farmState.Enabled then return end
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	if not (root and farmState.BodyGyro and camera) then return end
	if UserInputService:GetFocusedTextBox() then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		return
	end
	local moveDir = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camera.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camera.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camera.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camera.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0, 1, 0) end
	if moveDir.Magnitude > 0 then
		root.CFrame = root.CFrame + (moveDir * (FARM_FLY_SPEED / 50))
	end
	local _, yaw = camera.CFrame:ToOrientation()
	farmState.BodyGyro.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end)

-- Real noclip -- ported directly from Main's own NoClip (continuously forces every
-- currently-collidable BasePart to CanCollide = false, remembering only what it actually
-- changed so turning Farm off restores exactly that, not anything that was already
-- non-collidable for some other reason).
RunService.Stepped:Connect(function()
	if not farmState.Enabled then return end
	local character = Player.Character
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			local parent = part.Parent
			local isRigAccessory = parent and (parent:IsA("Accessory") or parent:IsA("Tool"))
			if not isRigAccessory then
				farmState.NoclipOriginal[part] = true
				part.CanCollide = false
			end
		end
	end
end)


-- ============================================================================
-- Auto Shoot is the main feature now (holds the fire button down rather than clicking
-- repeatedly -- you mentioned weapons here fire off a held mouse button, not click-by-
-- click, so that's what's simulated: one press when turned on, one release when turned
-- off, not a click loop). Auto Aim moved inside Edit as a refinement -- gated on Auto
-- Shoot's own master toggle, same "master gates the whole feature, Edit refines it"
-- pattern as Ability Spam and Reduce Lag elsewhere in this file.
--
-- Real bug fixed in Auto Aim itself: the nearest-target scan ran in a bare task.spawn loop
-- with no error handling -- if literally anything in a single iteration threw (a zombie
-- getting destroyed mid-read between the FindFirstChild("Head") check and reading its
-- Position is a very plausible everyday race, given a wave game deletes them constantly),
-- an uncaught error inside a task.spawn'd coroutine kills that coroutine PERMANENTLY, not
-- just that one iteration -- the loop would just never run again, leaving whatever target
-- it had cached (frequently a since-destroyed one, since that's what likely errored) stuck
-- forever. That lines up exactly with "worked for a few seconds then broke": it worked
-- until the first mid-scan error, then silently died for good. Now wrapped in pcall so one
-- bad iteration can't take down every iteration after it.
-- ============================================================================
local function PressMouse1()
	if type(mouse1press) == "function" then
		local ok = pcall(mouse1press)
		if ok then return true end
	end
	local loc = UserInputService:GetMouseLocation()
	return pcall(function()
		VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, true, game, 1)
	end)
end
local function ReleaseMouse1()
	if type(mouse1release) == "function" then
		local ok = pcall(mouse1release)
		if ok then return end
	end
	local loc = UserInputService:GetMouseLocation()
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 0, false, game, 1)
	end)
end

local autoShootState = {Enabled = false, Pressed = false}

-- Real bug found: this had no timeout, and the hub's own Execute button runs this whole
-- script SYNCHRONOUSLY (loadstring + pcall on the same thread, blocking until it returns) --
-- if TaskRemote2 hadn't replicated yet at the moment this script actually ran (executed from
-- the lobby, before fully loading into a round, etc.), this line alone would hang forever,
-- which every symptom described (stuck on "Loading...", the whole hub effectively frozen
-- since the hub's own Busy debounce never gets released either) matches exactly. Bounded to
-- 10s and guarded instead so the rest of the panel still loads and works even if this one
-- listener can't be wired up yet.
local TaskRemote2 = ReplicatedStorage:WaitForChild("TaskRemote2", 10)
-- Second listener alongside the game's own TaskLocal -- Roblox lets a RemoteEvent have any
-- number of OnClientEvent connections, so this doesn't interfere with (or need to touch)
-- what TaskLocal itself is already doing with the same event.
if TaskRemote2 then
	TaskRemote2.OnClientEvent:Connect(function(part)
		if part and part:IsA("BasePart") then
			taskState.CurrentPart = part
		else
			taskState.CurrentPart = nil
		end
	end)
end

-- Catches whatever task was ALREADY assigned before this script ever started -- TaskRemote2
-- only fires again once the current task changes, so if this loads mid-round (task already
-- handed out before injection), the listener above alone never sees it and CurrentPart
-- stays nil until the current task somehow finishes on its own. TaskLocal's own script
-- enables exactly one task prompt at a time and disables every other one, so scanning for
-- whichever "Task" prompt is currently Enabled finds the live one directly, without
-- needing to know that map's task-folder path.
local function FindActiveTaskPart()
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") and descendant.ActionText == "Task" and descendant.Enabled then
			return descendant.Parent
		end
	end
	return nil
end
taskState.CurrentPart = FindActiveTaskPart()

local function FireButton(button)
	if not button then return false end
	if type(firesignal) == "function" then
		-- The Download task's own Button is wired to .Activated, not .MouseButton1Click
		-- (CodePad's digit/Finish buttons and Press-or-Die's ButtonActive both use
		-- MouseButton1Click instead) -- that mismatch is almost certainly why Download
		-- never actually pressed: firing MouseButton1Click only runs listeners connected to
		-- THAT exact signal, never a totally separate Activated connection on the same
		-- button. Firing both covers whichever one a given button actually uses -- firing a
		-- signal nothing is connected to is a harmless no-op.
		local firedActivated = pcall(firesignal, button.Activated)
		local firedClick = pcall(firesignal, button.MouseButton1Click)
		if firedActivated or firedClick then return true end
	end
	-- Fallback for executors without firesignal -- a real click simulated at the button's
	-- own screen position. Less reliable (covered/offscreen buttons can miss) but better
	-- than nothing.
	if type(mousemoveabs) == "function" and type(mouse1click) == "function" then
		local pos = button.AbsolutePosition + button.AbsoluteSize / 2
		pcall(mousemoveabs, pos.X, pos.Y)
		pcall(mouse1click)
		return true
	end
	return false
end

-- Finds the LIVE Monitor clone specifically -- the one with Visible true -- rather than
-- whichever "Monitor" FindFirstChild happens to return first.
local function FindVisibleChild(parent, name)
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == name and child.Visible then
			return child
		end
	end
	return nil
end

-- Type 1: "Download" -- click the on-screen Button once, then TaskHandler's own script
-- runs the real 4-second progress fill and fires TaskRemote:FireServer itself.
local function HandleDownloadTask(monitor)
	local button = monitor.Screen:WaitForChild("Button", 2)
	if button and button.Active then
		FireButton(button)
	end
	-- Give the real 4s fill (plus its own finish delay) time to complete on its own.
	local start = os.clock()
	while os.clock() - start < 6 and monitor.Parent do
		task.wait(0.25)
	end
end

-- Type 3: "Code Pad" -- reads the same 4-digit code TaskHandler's script wrote onto the
-- in-world Paper prop, clicks each matching digit button, then Finish.
local function HandleCodeTask(codePad)
	local paper = codePad:FindFirstChild("Paper")
	local codeText = paper and paper:FindFirstChild("textik")
	local start = os.clock()
	while (not codeText or codeText.Text == "") and os.clock() - start < 2 do
		task.wait(0.1)
		paper = codePad:FindFirstChild("Paper")
		codeText = paper and paper:FindFirstChild("textik")
	end
	if not codeText or codeText.Text == "" then return end
	local code = codeText.Text
	for i = 1, #code do
		local digit = code:sub(i, i)
		local digitButton = codePad:FindFirstChild(digit)
		FireButton(digitButton)
		task.wait(0.12)
	end
	local finishButton = codePad:FindFirstChild("Finish")
	FireButton(finishButton)
	task.wait(0.3)
end

-- Type 2: "Press or Die" -- five rounds of a button that spawns at a random screen
-- position and shrinks back over 1.2s; must click each ButtonActive before it shrinks
-- back, missing even one aborts the whole minigame (TaskHandler's own logic, not this
-- script's), so this polls fast and clicks the instant one appears.
local function HandlePressTask(pressing)
	local clicked = {}
	local start = os.clock()
	while os.clock() - start < 12 and pressing.Parent do
		for _, child in ipairs(pressing:GetChildren()) do
			if child.Name == "ButtonActive" and not clicked[child] then
				clicked[child] = true
				FireButton(child)
			end
		end
		task.wait(0.03)
	end
end

-- Wraps just the teleport-in/trigger/play-the-minigame window in a temporary noclip so
-- SetRootUpright dropping the killer right next to (or slightly inside) task scenery
-- doesn't get physics-shoved around or stuck on it -- same accessory/HumanoidRootPart-safe
-- CanCollide toggle as MM2's Coin Farm noclip. Noclip alone means gravity just pulls
-- straight through the floor with nothing solid underneath anymore, so this also holds
-- vertical velocity at zero the whole time, the minimum a "fly" would actually be doing
-- for this -- horizontal velocity is left alone since nothing here is trying to move you
-- sideways.
local function BeginTaskNoclip(character)
	local touched = {}
	for _, part in ipairs(character:GetDescendants()) do
		local parent = part.Parent
		local isRigAccessory = parent and (parent:IsA("Accessory") or parent:IsA("Tool"))
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.CanCollide and not isRigAccessory then
			touched[part] = true
			part.CanCollide = false
		end
	end
	local antiFallConnection = RunService.Heartbeat:Connect(function()
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
		end
	end)
	return touched, antiFallConnection
end

local function EndTaskNoclip(touched, antiFallConnection)
	if antiFallConnection then antiFallConnection:Disconnect() end
	for part in pairs(touched) do
		if part.Parent then part.CanCollide = true end
	end
end

-- Tries to detect and solve whatever minigame is CURRENTLY open, regardless of how it got
-- that way -- this script teleporting+triggering the prompt itself, or you walking up and
-- pressing E yourself with Auto Teleport off. Shared by both paths (below) instead of
-- duplicated, so there's exactly one place that actually plays a minigame.
local function TryDetectAndSolveOpenTask(tasksGui, preExistingButtons)
	local monitor = FindVisibleChild(tasksGui, "Monitor")
	if monitor then
		HandleDownloadTask(monitor)
		return true
	end
	if tasksGui.CodePad and tasksGui.CodePad.Visible then
		HandleCodeTask(tasksGui.CodePad)
		return true
	end
	local pressing = tasksGui:FindFirstChild("Pressing")
	if pressing then
		for _, child in ipairs(pressing:GetChildren()) do
			if child.Name == "ButtonActive" and not (preExistingButtons and preExistingButtons[child]) then
				HandlePressTask(pressing)
				return true
			end
		end
	end
	return false
end

-- True for as long as the watcher below is actively solving something -- checked by
-- RunTaskAtPart (so Busy spans the whole solve, not just the trigger) and by Auto Report
-- (so it won't try to walk off and report mid-task -- see the note further down about the
-- two fighting over character control).
solvingTask = false

-- Always running while Auto Task is on, independent of Auto Teleport -- this is what
-- actually plays a minigame open by a manual E-press when teleport-assist is off, and it's
-- also what RunTaskAtPart (below) waits on after triggering a prompt itself.
task.spawn(function()
	while true do
		task.wait(0.2)
		if not ScreenGui.Parent then return end
		if taskState.Enabled and not solvingTask then
			local playerGui = Player:FindFirstChildOfClass("PlayerGui")
			local tasksGui = playerGui and playerGui:FindFirstChild("TasksGui")
			if tasksGui then
				solvingTask = true
				pcall(TryDetectAndSolveOpenTask, tasksGui, nil)
				solvingTask = false
			end
		end
	end
end)

local function RunTaskAtPart(part)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return end
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	-- TaskLocal's own script disables this prompt locally the instant ANY Triggered fires
	-- (including our own simulated one) as a purely cosmetic "task begun" reaction -- that
	-- doesn't mean the server actually advanced anything. taskState.CurrentPart still
	-- pointing at this same part on the next attempt means the server hasn't moved on, so
	-- force it back on and retry instead of treating that local-only Enabled=false as a
	-- real lock -- bailing out here on every retry (the old behavior) is what left a broken
	-- task stuck forever with no new one ever generated.
	prompt.Enabled = true

	SetRootUpright(root, root.CFrame, part.Position - Vector3.new(0, 3, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	task.wait(taskState.TriggerDelay)
	if not TriggerPrompt(prompt) then return end

	-- The watcher above picks up whatever this trigger just opened -- wait here for it to
	-- actually notice and finish, so this function (and taskState.Busy, which wraps it)
	-- covers the whole solve, not just the trigger step.
	local start = os.clock()
	while not solvingTask and os.clock() - start < 2.5 do
		task.wait(0.05)
	end
	start = os.clock()
	while solvingTask and os.clock() - start < 15 do
		task.wait(0.1)
	end
end

TaskToggle.MouseButton1Click:Connect(function()
	taskState.Enabled = not taskState.Enabled
	TaskToggle.Text = taskState.Enabled and "On" or "Off"
	-- Picks up whatever task is already live the moment this gets turned on, instead of
	-- only ever noticing one via TaskRemote2 firing again in the future -- covers exactly
	-- the "toggled on mid-round, never finds the task" case.
	if taskState.Enabled and not taskState.CurrentPart then
		taskState.CurrentPart = FindActiveTaskPart()
	end
end)

-- "Safe place" once every task is done -- workspace:GetAttribute("TasksFinished") is
-- confirmed real (TimeFrame's own dumped script branches on it too), so this isn't a
-- guessed signal. Reuses the same noclip+anti-fall pair tasks themselves use: teleport
-- straight up well above the map and hold there, instead of the old behavior of just
-- sitting at the last task and endlessly re-triggering its now-pointless prompt.
local safePlace = {Active = false, Touched = nil, AntiFallConnection = nil}
local function EngageSafePlace(character)
	if safePlace.Active then return end
	safePlace.Active = true
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then root.CFrame = root.CFrame + Vector3.new(0, 60, 0) end
	safePlace.Touched, safePlace.AntiFallConnection = BeginTaskNoclip(character)
end
local function DisengageSafePlace()
	if not safePlace.Active then return end
	EndTaskNoclip(safePlace.Touched, safePlace.AntiFallConnection)
	safePlace.Touched, safePlace.AntiFallConnection = nil, nil
	safePlace.Active = false
end

RunService.Heartbeat:Connect(function()
	if not ScreenGui.Parent then return end
	-- Confirmed real (TaskFrame's own script branches on it) -- true only while actually
	-- in a live round, false in the lobby/menu. Suspect calls the lobby/spectator state a
	-- "Ghost" per request, but InGame is the one signal already confirmed to distinguish
	-- "actually playing" either way, so this is what both Auto Task and Auto Report gate on.
	if Player:GetAttribute("InGame") ~= true or not taskState.Enabled or workspace:GetAttribute("Meeting") == true then
		DisengageSafePlace()
		return
	end

	local character = Player.Character
	-- Also gated on AutoTeleport now -- with it off, this shouldn't be doing ANY automatic
	-- teleporting, the safe-place hover included, not just skipping the walk-to-task part.
	if workspace:GetAttribute("TasksFinished") == true and taskState.AutoTeleport then
		if character then EngageSafePlace(character) end
		return
	end
	DisengageSafePlace()

	-- Same mutual-exclusion reasoning as Auto Report's own Heartbeat below (see its
	-- comment) -- don't start a new teleport-and-trigger while Auto Report currently has
	-- the character mid-walk to a body/Emergency.
	if taskState.Busy or not taskState.AutoTeleport or reportState.Busy then return end
	local part = taskState.CurrentPart or FindActiveTaskPart()
	taskState.CurrentPart = part
	if not part or not part.Parent then return end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end

	taskState.Busy = true
	task.spawn(function()
		local touched, antiFallConnection = BeginTaskNoclip(character)
		pcall(RunTaskAtPart, part)
		EndTaskNoclip(touched, antiFallConnection)
		-- Small settle delay before allowing the next attempt -- if the task genuinely
		-- didn't complete (detection missed something, or the server hasn't advanced
		-- CurrentPart yet), this stops it from re-triggering the exact same prompt on the
		-- very next Heartbeat and thrashing whatever GUI state is still mid-cleanup.
		task.wait(0.2)
		taskState.Busy = false
	end)
end)

-- ============================================================================
-- Auto Report: fully automatic -- no manual button. Every live "Dead Body" ProximityPrompt
-- (matched by its exact ActionText/ObjectText, same pair confirmed on the dump's own
-- DeadPrompt template -- not a fixed path, since a real body spawns wherever the kill
-- happened) gets walked to and reported; when there's no body to report, the Emergency
-- button gets walked to and pressed instead. Both gated behind Suspect's real per-map
-- EmergencyModel.Timer when it can be read, falling back to the ~30s
-- Player:GetAttribute("InGame") window otherwise. The emergency fallback has its own
-- longer cooldown (60s) so it doesn't just spam-call meetings back to back when no one's
-- dead.
--
-- Live prompts are tracked via DescendantAdded/Removing instead of rescanning
-- workspace:GetDescendants() every frame -- that full-tree walk every single Heartbeat is
-- what was making this laggy. An initial one-time sweep catches anything already in the
-- world when this loads, then the two connections keep the small cached set current from
-- there with no further scanning at all.
-- ============================================================================

-- Fallback only -- kept in case a map's EmergencyModel.Timer (below) can't be read for
-- some reason, so reporting still eventually unlocks instead of staying gated forever.
local roundStartedAt = nil
local function MarkRoundStart()
	roundStartedAt = os.clock()
end
if Player:GetAttribute("InGame") == true then MarkRoundStart() end
Player:GetAttributeChangedSignal("InGame"):Connect(function()
	if Player:GetAttribute("InGame") == true then MarkRoundStart() end
end)
local REPORT_COOLDOWN_SECONDS = 30
local function FallbackReportGate()
	return roundStartedAt ~= nil and (os.clock() - roundStartedAt) >= REPORT_COOLDOWN_SECONDS
end

-- Confirmed: every map has its own Ragdolls folder (e.g. workspace.Map.Prison.Ragdolls)
-- that a dead player's body actually gets parented into the instant they die -- this is
-- now the primary signal instead of the property-based guess below. That guess
-- (ActionText == "Report" and ObjectText == "Dead Body") is kept as a fallback for the same
-- reason EmergencyModel's Timer has one: it's very plausible a freshly-cloned ragdoll's
-- ActionText/ObjectText properties replicate a moment AFTER it's actually parented in, in
-- which case DescendantAdded firing at the exact instant of parenting would check those
-- properties too early and permanently miss it (that event only ever fires once per
-- instance) -- anything with a ProximityPrompt that's actually inside the Ragdolls folder
-- doesn't need that property check at all, since the folder itself already tells you
-- what it is.
local ragdollsFolder
local function ResolveRagdollsFolder()
	if ragdollsFolder and ragdollsFolder.Parent then return end
	ragdollsFolder = workspace:FindFirstChild("Ragdolls", true)
end
ResolveRagdollsFolder()

local function IsDeadBodyPrompt(descendant)
	if not descendant:IsA("ProximityPrompt") then return false end
	if descendant.ActionText == "Report" and descendant.ObjectText == "Dead Body" then return true end
	return ragdollsFolder ~= nil and descendant:IsDescendantOf(ragdollsFolder)
end

local deadBodyPrompts = {}
for _, descendant in ipairs(workspace:GetDescendants()) do
	if IsDeadBodyPrompt(descendant) then deadBodyPrompts[descendant] = true end
end
workspace.DescendantAdded:Connect(function(descendant)
	ResolveRagdollsFolder()
	if IsDeadBodyPrompt(descendant) then deadBodyPrompts[descendant] = true end
end)
workspace.DescendantRemoving:Connect(function(descendant)
	deadBodyPrompts[descendant] = nil
end)

-- Enabled is NOT checked here anymore -- confirmed from an actual decompiled dump
-- (place 121268060261990 Suspect(2).rbxlx) that this game disables ProximityPrompts by
-- default and only flips them on server-side once some condition is met (same pattern
-- already relied on for task prompts and the Emergency button below), so a body's own
-- prompt sitting Enabled=false was very likely why nothing was ever getting reported at all
-- -- this was gating on a signal that was never expected to be true going in.
-- WalkAndTrigger below force-enables it right before firing anyway.
local function FindDeadBodyPrompt()
	for prompt in pairs(deadBodyPrompts) do
		if prompt.Parent then return prompt end
		deadBodyPrompts[prompt] = nil
	end
	return nil
end

-- Every map has its own EmergencyModel (e.g. workspace.Map.Airport.EmergencyModel,
-- workspace.Map.Mansion.EmergencyModel) -- FindFirstChild(..., true) searches the whole
-- tree recursively so this finds whichever one actually exists in the currently loaded map
-- without caring what map it is. Retried (not resolved once) since the map might not have
-- finished streaming in yet the moment this script starts.
local emergencyModel, emergencyPrompt
local function ResolveEmergencyModel()
	if emergencyModel and emergencyModel.Parent then return end
	emergencyModel = workspace:FindFirstChild("EmergencyModel", true)
	if not emergencyModel then return end
	local button = emergencyModel:FindFirstChild("Button")
	emergencyPrompt = button and button:FindFirstChildOfClass("ProximityPrompt")
end
ResolveEmergencyModel()

-- Confirmed from the same dump: EmergencyModel.Timer isn't a NumberValue or a clean
-- countdown string at all -- it's a physical 3D sign (a UnionOperation part with a
-- SurfaceGui) whose displayed text format isn't reliable to parse, and the button's own
-- ProximityPrompt is confirmed Enabled=false at rest. That Enabled flag is the actual
-- server-authoritative "can you press this yet" signal (the same pattern this game already
-- uses for task prompts), so this reads that directly instead of guessing at sign text
-- formatting. Falls back to the InGame-based timer guess only if the model/prompt can't be
-- resolved at all.
local function IsReportReady()
	ResolveEmergencyModel()
	if not emergencyPrompt then return FallbackReportGate() end
	return emergencyPrompt.Enabled == true
end

local function WalkAndTrigger(prompt)
	local anchor = prompt.Parent
	if not anchor then return end
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local position
	if anchor:IsA("BasePart") then
		position = anchor.Position
	elseif anchor:IsA("Model") or anchor:IsA("Attachment") then
		position = anchor:IsA("Attachment") and anchor.WorldPosition or anchor:GetPivot().Position
	end
	if not position then return end
	SetRootUpright(root, root.CFrame, position - Vector3.new(0, 2, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	-- One frame, not a real delay -- reporting/calling a meeting should be as close to
	-- instant as possible, this is only here so the teleport has actually replicated
	-- before the trigger fires.
	task.wait()
	-- Same fix as the task prompts: the Emergency button's own prompt is very likely
	-- Enabled=false during its countdown and only flips true once the Timer actually hits
	-- 0 -- IsReportReady() already waits for that, but if Enabled replicates even slightly
	-- after the Timer value does, this could still walk over and try to fire a prompt
	-- that's technically still disabled, which fireproximityprompt (correctly) treats as a
	-- no-op -- exactly "teleports there but doesn't press it." Forcing it on costs nothing
	-- if it was already enabled.
	prompt.Enabled = true
	TriggerPrompt(prompt)
end

-- Global, not local -- Auto Task's own Heartbeat (declared earlier in the file) reads
-- reportState.Busy for the same mutual-exclusion check, and a local here wouldn't be
-- visible as an upvalue to code positioned before this line. Still fine either way: both
-- are just function bodies that only actually run later (once Heartbeat starts firing),
-- well after this assignment has already happened during the script's initial top-to-
-- bottom execution.
reportState = {Enabled = false, LastReport = 0, LastMeetingCall = 0, Busy = false}
ReportToggle.MouseButton1Click:Connect(function()
	reportState.Enabled = not reportState.Enabled
	ReportToggle.Text = reportState.Enabled and "On" or "Off"
end)

-- Shared gate + trigger, callable both from the Heartbeat poller below AND directly from an
-- event the instant it fires (a ragdoll getting added to the Ragdolls folder), instead of
-- only ever reacting on the next Heartbeat frame. The whole point is getting there before
-- anyone else on the server does.
--
-- Real bug fixed here: the old Heartbeat gated BOTH dead-body reporting AND the Emergency
-- button behind IsReportReady() (the Emergency meeting-timer/cooldown gate). That's correct
-- for the Emergency button, but a dead body can legitimately turn up well before that timer
-- is ready, and reporting one is what CAUSES a meeting -- it was never supposed to wait on
-- it. That shared, wrongly-scoped gate is almost certainly what made reporting feel
-- sluggish/not-instant even though the teleport itself was working fine. Emergency-only
-- callers now pass shouldGateOnTimer = true; body reports pass false.
local function TryReportNow(prompt, cooldownKey, cooldownSeconds, shouldGateOnTimer)
	if not ScreenGui.Parent then return end
	if Player:GetAttribute("InGame") ~= true then return end
	if not reportState.Enabled or reportState.Busy then return end
	if workspace:GetAttribute("Meeting") == true then return end
	-- Auto Task owning the character (walking to a task, or a minigame from THIS session's
	-- own trigger currently being solved) is very likely why reporting/pressing Emergency
	-- was going nowhere despite the teleport landing -- pressing E for a report or the
	-- Emergency button while the game still considers you "in a task" may just not be
	-- allowed, and either way two of this script's own loops fighting for the same
	-- HumanoidRootPart every frame was never going to end well. Simplest fix: don't even
	-- try while Auto Task has something in progress.
	if taskState.Busy or solvingTask then return end
	if not prompt or not prompt.Parent then return end
	if shouldGateOnTimer and not IsReportReady() then return end
	if os.clock() - reportState[cooldownKey] < cooldownSeconds then return end
	reportState[cooldownKey] = os.clock()
	reportState.Busy = true
	task.spawn(function()
		WalkAndTrigger(prompt)
		reportState.Busy = false
	end)
end

-- Instant reaction: as soon as a body's ProximityPrompt is actually parented into the
-- Ragdolls folder, try to report it immediately rather than waiting for the next Heartbeat
-- frame. Separate connection from the cache-populating one earlier in the file (that one has
-- to run first, and this one needs WalkAndTrigger/reportState which aren't defined until
-- here) -- Roblox allows multiple listeners on the same event with no conflict.
workspace.DescendantAdded:Connect(function(descendant)
	if IsDeadBodyPrompt(descendant) then
		TryReportNow(descendant, "LastReport", 3, false)
	end
end)

RunService.Heartbeat:Connect(function()
	local prompt = FindDeadBodyPrompt()
	if prompt then
		TryReportNow(prompt, "LastReport", 3, false)
		return
	end
	TryReportNow(emergencyPrompt, "LastMeetingCall", 60, true)
end)

-- ============================================================================
-- Auto Accuse: once a meeting actually starts (workspace's own "Meeting" attribute, the
-- same one everything above already treats as authoritative), work through the real vote
-- flow: "have you seen the killer" (Question1) -> Yes, find the killer's own red button
-- directly inside VotingFrame.Accuse and click it, then a "Kick out {name}?" Yes/No
-- confirmation with a short visible countdown -- confirmed by screenshot, not a guessed
-- path (unlike Question1/Accuse above), so it's found by its own displayed text instead of
-- an assumed instance path. Answered based on whether the named player is actually the
-- killer (Yes if so, No otherwise) rather than always Yes, in case someone else on the
-- server ends up nominated instead. The accuse-button lookup itself is still deliberately
-- flexible (name match OR any descendant label's text) since the exact per-player button
-- structure inside Accuse wasn't specified, just that it's red buttons. Only runs while
-- Auto Report itself is on, since this is that toggle's own follow-through once a meeting
-- it caused (or anyone else's) actually happens.
-- ============================================================================
-- Continuously-tracked, round-persistent killer instead of a fresh one-shot scan at
-- vote-time: a scan done only once right as the vote confirmation UI appears can land in a
-- window where a role signal (KillerFolder entry, attribute, Team name) is mid-flicker
-- around the meeting transition, and a one-shot scan also has no way to tell a genuinely
-- CURRENT killer apart from some other player who happens to still be carrying a stale
-- leftover attribute/KillerFolder entry from the PREVIOUS round if it wasn't cleaned up
-- instantly. This instead polls continuously through the round, locks in the first real
-- match it finds, and holds that value until the round actually restarts (reset on
-- Player's own InGame attribute flipping back to true) -- same ESP-detection logic
-- (IsPlayerKiller) as everywhere else, just captured early and cached instead of
-- re-derived fresh at the one moment it's most likely to be unreliable.
local knownKiller = nil
if Player:GetAttribute("InGame") == true then knownKiller = nil end
Player:GetAttributeChangedSignal("InGame"):Connect(function()
	if Player:GetAttribute("InGame") == true then knownKiller = nil end
end)
task.spawn(function()
	while true do
		task.wait(0.5)
		if not ScreenGui.Parent then return end
		if Player:GetAttribute("InGame") == true and not knownKiller then
			for _, candidate in ipairs(Players:GetPlayers()) do
				if candidate ~= Player and IsPlayerKiller(candidate) then
					knownKiller = candidate
					break
				end
			end
		end
	end
end)

local function GetKnownKiller()
	return knownKiller
end

-- Cheap defensive no-op for the common case (checked against the decompiled dump: none of
-- the voting labels actually use RichText) -- kept in case that ever changes, since
-- stripping non-existent tags costs nothing. Declared up here since both FindAccuseButton
-- and ExtractKickTargetName below need it.
local function StripRichText(text)
	return (text:gsub("<[^>]->", ""))
end

-- PlayerList (VotingFrame.Accuse.PlayerList, confirmed to exist and use a UIGridLayout) is
-- confirmed empty outside of an active meeting -- its actual per-player buttons are built at
-- runtime by a script whose source isn't visible client-side, so unlike Question2 there's no
-- concrete template to target directly. This stays deliberately flexible, matching
-- case-insensitively so minor display-casing differences don't cause a false miss. Getting
-- this wrong is low-stakes now: even if it clicks the wrong player's accuse button (or none
-- at all), the actual "Kick out X?" confirmation is answered separately based on whichever
-- named player really ends up nominated, not on what this function picked.
local function FindAccuseButton(accuse, targetPlayer)
	local targetName = targetPlayer.Name:lower()
	local targetDisplay = targetPlayer.DisplayName:lower()
	for _, descendant in ipairs(accuse:GetDescendants()) do
		if descendant:IsA("GuiButton") then
			local name = descendant.Name:lower()
			local text = StripRichText(descendant.Text or ""):lower()
			if name == targetName or name == targetDisplay or text == targetName or text == targetDisplay then
				return descendant
			end
		end
	end
	-- Button itself might just say "Accuse" with the player's name on a sibling label
	-- instead of on the button -- fall back to matching by nearby container.
	for _, descendant in ipairs(accuse:GetDescendants()) do
		if descendant:IsA("GuiObject") then
			local matches = false
			for _, label in ipairs(descendant:GetDescendants()) do
				if label:IsA("TextLabel") and label.Text ~= "" then
					local text = StripRichText(label.Text):lower()
					if text == targetName or text == targetDisplay
						or text:find(targetName, 1, true) or text:find(targetDisplay, 1, true) then
						matches = true
						break
					end
				end
			end
			if matches then
				if descendant:IsA("GuiButton") then return descendant end
				for _, button in ipairs(descendant:GetDescendants()) do
					if button:IsA("GuiButton") then return button end
				end
			end
		end
	end
	return nil
end

-- "Kick out Pandete?" -> extracts "Pandete". Anchored at both ends so it doesn't
-- accidentally match some other unrelated "Kick out ..." string.
local function ExtractKickTargetName(text)
	if not text then return nil end
	text = StripRichText(text)
	return text:match("^%s*Kick%s+[Oo]ut%s+(.-)%s*%?%s*$")
end

local function FindPlayerByNameOrDisplay(name)
	if not name then return nil end
	for _, candidate in ipairs(Players:GetPlayers()) do
		if candidate.Name == name or candidate.DisplayName == name then
			return candidate
		end
	end
	return nil
end

-- Confirmed directly from a decompiled dump of a live meeting (place 121268060261990
-- Suspect(2).rbxlx): the "Kick out {name}?" confirmation is NOT some generic dialog found by
-- walking up from matched text -- it's VotingFrame.Question2 itself, a sibling of Question1,
-- with a TextLabel literally named "username" holding the "Kick out {name}?" text and
-- TextButtons literally named "Yes"/"No". Going straight to that confirmed path instead of
-- the old broad "scan every TextLabel in PlayerGui, walk up to 4 ancestors looking for
-- Yes/No" approach removes basically all the guesswork that was likely why this never fired
-- -- gated on Question2.Visible so it can't act on the frame's own default/placeholder state.
local function TryHandleKickConfirmation(votingFrame)
	local question2 = votingFrame:FindFirstChild("Question2")
	if not question2 or not question2.Visible then return false end
	local label = question2:FindFirstChild("username")
	local yes = question2:FindFirstChild("Yes")
	local no = question2:FindFirstChild("No")
	if not (label and yes and no) then return false end
	local targetName = ExtractKickTargetName(label.Text)
	if not targetName then return false end
	local targetPlayer = FindPlayerByNameOrDisplay(targetName)
	local isKiller = targetPlayer ~= nil and IsPlayerKiller(targetPlayer)
	FireButton(isKiller and yes or no)
	return true
end

local function AutoAccuseKiller()
	local playerGui = Player:FindFirstChildOfClass("PlayerGui")
	local inGameGui = playerGui and playerGui:WaitForChild("InGameGui", 5)
	local votingFrame = inGameGui and inGameGui:WaitForChild("VotingFrame", 5)
	if not votingFrame then return end

	-- Real bug fixed here: this used to bail out completely if GetKnownKiller() hadn't
	-- locked onto anyone yet, which meant the confirmation-watching loop below (which
	-- doesn't require WE be the one accusing) never even ran -- if anyone else on the server
	-- nominated someone, the "Kick out X?" question would just sit there unanswered even
	-- though answering it doesn't depend on us knowing the killer in advance at all. Now
	-- accusing is just skipped (not the whole function) when we don't have a known killer.
	local killer = GetKnownKiller()
	if killer then
		-- Give the frame a moment to actually populate (the accuse buttons especially are
		-- very likely built dynamically once the meeting starts, not sitting there in advance).
		task.wait(1)

		local question1 = votingFrame:FindFirstChild("Question1")
		FireButton(question1 and question1:FindFirstChild("Yes"))
		task.wait(0.5)

		local accuse = votingFrame:WaitForChild("Accuse", 5)
		if accuse then
			local start = os.clock()
			local accuseButton = FindAccuseButton(accuse, killer)
			while not accuseButton and os.clock() - start < 3 do
				task.wait(0.2)
				accuseButton = FindAccuseButton(accuse, killer)
			end
			if accuseButton then FireButton(accuseButton) end
		end
	end

	-- Keep watching for the real "Kick out X?" confirmation regardless of whether we clicked
	-- an accuse button ourselves above -- someone else on the server may end up nominated
	-- instead, and this always answers based on whether THAT actual named player is the real
	-- killer. 20s covers the accuse phase plus a normal vote-confirmation window.
	local waitStart = os.clock()
	while os.clock() - waitStart < 20 do
		if TryHandleKickConfirmation(votingFrame) then return end
		task.wait(0.15)
	end
end

workspace:GetAttributeChangedSignal("Meeting"):Connect(function()
	if workspace:GetAttribute("Meeting") == true and reportState.Enabled then
		task.spawn(AutoAccuseKiller)
	end
end)


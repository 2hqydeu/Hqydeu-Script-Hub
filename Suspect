-- Auto Kill: now a "gather everyone" sweep instead of cycling one target at a time --
-- ported from a completely different MM2 script's own "Kill EVERYONE as murderer" (that
-- game's version: equip the Knife, Anchor every other player's HumanoidRootPart, snap them
-- ALL to one point right in front of you, then fire the attack once so it lands on the
-- whole pile at the same time). Suspect's actual attack mechanism is still a guess (see the
-- Tool.Activated + WeaponEvent double-fire below, unchanged from before), but freezing
-- every target in one spot instead of relying on a clean individual hit on each one in turn
-- is worth trying regardless of exactly how the hit itself registers. Un-anchors everyone
-- again after each attempt -- leaving other players permanently frozen in place if a kill
-- doesn't land would be its own very obvious problem.
-- ============================================================================
local KillRow, KillToggle = CreateFeatureRow(1, "Auto Kill")

local killState = {Enabled = false}
KillToggle.MouseButton1Click:Connect(function()
	killState.Enabled = not killState.Enabled
	KillToggle.Text = killState.Enabled and "On" or "Off"
end)

-- Suspect's killer is very likely handed an actual Knife-style Tool (like MM2/QOD's own
-- weapon Tools), and a real attack there normally goes through Tool.Activated -- which is
-- what actually runs the server's hit-detection/raycast before it ever touches WeaponEvent,
-- not something a bare WeaponEvent:FireServer() on its own can substitute for. Same class
-- of bug as the Download task button (a button/tool's real activation signal isn't always
-- the one you'd guess) -- so this finds and equips the killer's Tool and fires its
-- Activated, alongside the direct remote fire as a fallback in case there isn't one.
local function GetKillerTool(character)
	local tool = character:FindFirstChildOfClass("Tool")
	if tool then return tool end
	local backpack = Player:FindFirstChildOfClass("Backpack")
	local backpackTool = backpack and backpack:FindFirstChildOfClass("Tool")
	if backpackTool then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then pcall(function() humanoid:EquipTool(backpackTool) end) end
		return backpackTool
	end
	return nil
end

local function GetToolHandle(tool)
	return tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
end

-- Confirmed: teleporting works, but nothing was actually taking damage -- Tool.Activated +
-- WeaponEvent alone apparently isn't Suspect's real hit path either. MM2's own knife (a
-- different game, but the same style of Tool) deals its damage through Touched events on
-- the Handle, not a swing animation or remote fire alone -- Suspect's is plausibly the
-- same, so this also simulates the handle physically touching each gathered target, same
-- technique as MM2's own StabTarget (firetouchinterest, touch-start then touch-end).
local function FireAttack(character, weaponEvent, targets)
	local tool = GetKillerTool(character)
	if tool and type(firesignal) == "function" then
		pcall(firesignal, tool.Activated)
	end
	pcall(function() weaponEvent:FireServer() end)

	local handle = tool and GetToolHandle(tool)
	if handle and type(firetouchinterest) == "function" then
		for _, targetRoot in ipairs(targets) do
			if targetRoot.Parent then
				pcall(function()
					firetouchinterest(handle, targetRoot, 0)
					task.wait(0.03)
					firetouchinterest(handle, targetRoot, 1)
				end)
			end
		end
	end
end

task.spawn(function()
	while true do
		task.wait(0.5)
		if not ScreenGui.Parent then return end
		if killState.Enabled and Player:GetAttribute("InGame") == true and IsSuspectKiller() then
			local character = Player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local playersFolder = workspace:FindFirstChild("PlayersFolder")
			local weaponEvent = ReplicatedStorage:FindFirstChild("WeaponEvent")
			if humanoid and humanoid.Health > 0 and root and playersFolder and weaponEvent and weaponEvent:IsA("RemoteEvent") then
				local targets = {}
				for _, targetPlayer in ipairs(Players:GetPlayers()) do
					if targetPlayer ~= Player and playersFolder:FindFirstChild(targetPlayer.Name) then
						local targetCharacter = targetPlayer.Character
						local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
						local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
						if targetHumanoid and targetHumanoid.Health > 0 and targetRoot then table.insert(targets, targetRoot) end
					end
				end

				if #targets > 0 then
					local gatherCFrame = root.CFrame * CFrame.new(0, 0, -3)
					for _, targetRoot in ipairs(targets) do
						targetRoot.Anchored = true
						targetRoot.CFrame = gatherCFrame
					end

					-- A handful of attempts while everyone's held in place, not just the one
					-- shot the source script used -- Suspect's real hit requirements aren't
					-- confirmed, so this gives it a few tries at actually landing instead of
					-- one guess.
					for i = 1, 4 do
						if not killState.Enabled then break end
						FireAttack(character, weaponEvent, targets)
						task.wait(0.15)
					end

					for _, targetRoot in ipairs(targets) do
						if targetRoot.Parent then targetRoot.Anchored = false end
					end
				end
			end
		end
	end
end)

-- ============================================================================
-- Shared: fires a ProximityPrompt reliably. RequiresLineOfSight is dropped first (a real
-- client-side gate -- worth clearing regardless). For the actual trigger, this passes the
-- prompt's own real HoldDuration through to fireproximityprompt instead of always trying
-- an instant zero-hold tap: some servers verify how long a prompt was genuinely held via
-- their own replicated timing, not the client-readable HoldDuration property, so an
-- instant fake tap can get silently ignored where a fully "held" one wouldn't -- this is
-- likely why Emergency (walked to, never actually pressed) failed while Task prompts
-- (already using a real settle delay before firing) mostly didn't. Falls back to a bare
-- call if the executor's fireproximityprompt doesn't accept a duration argument.
-- ============================================================================
local function TriggerPrompt(prompt)
	if type(fireproximityprompt) ~= "function" then return false end
	pcall(function() prompt.RequiresLineOfSight = false end)
	local holdDuration = prompt.HoldDuration
	local success = pcall(fireproximityprompt, prompt, holdDuration)
	if success then return true end
	return pcall(fireproximityprompt, prompt)
end

